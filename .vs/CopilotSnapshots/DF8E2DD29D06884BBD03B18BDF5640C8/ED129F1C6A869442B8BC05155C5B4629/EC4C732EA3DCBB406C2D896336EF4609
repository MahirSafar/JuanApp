@using JuanApp.Domain.Models
@model OrderListViewModel
@{
    ViewData["Title"] = "Order Management";
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/order-index.css" />
}

<div class="zenith-page-wrapper">
    <div class="zenith-page-header">
        <div class="zenith-breadcrumb">
            <a asp-action="Index" asp-controller="Dashboard" class="zenith-breadcrumb-item">
                <i class="fas fa-chart-line"></i> Dashboard
            </a>
            <span class="zenith-breadcrumb-separator"><i class="fas fa-chevron-right"></i></span>
            <span class="zenith-breadcrumb-current">Orders</span>
        </div>
        <h1 class="zenith-page-title">
            <i class="fas fa-shopping-cart"></i>
            Order Management
        </h1>
    </div>

    <!-- Filter Section -->
    <div class="zenith-card">
        <div class="zenith-card-header">
            <h4 class="zenith-card-title">
                <i class="fas fa-filter"></i>
                Order Filters
            </h4>
        </div>
        <div class="zenith-card-body">
            <form method="get" asp-action="Index" class="zenith-filter-form">
                <div class="zenith-form-group">
                    <label for="status" class="zenith-label">Order Status</label>
                    <select name="status" id="status" class="zenith-select">
                        <option value="">All Orders</option>
                        <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                        <option value="Confirmed" selected="@(Model.StatusFilter == "Confirmed")">Confirmed</option>
                        <option value="Shipped" selected="@(Model.StatusFilter == "Shipped")">Shipped</option>
                        <option value="Delivered" selected="@(Model.StatusFilter == "Delivered")">Delivered</option>
                        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="zenith-form-actions">
                    <button type="submit" class="zenith-btn zenith-btn-primary">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                    <a asp-action="Index" class="zenith-btn zenith-btn-secondary">
                        <i class="fas fa-times"></i> Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="zenith-card">
        <div class="zenith-card-header">
            <h4 class="zenith-card-title">
                <i class="fas fa-list"></i>
                Orders (@Model.TotalCount)
            </h4>
        </div>
        <div class="zenith-card-body">
            @if (Model.Orders.Any())
            {
                <div class="zenith-table-wrapper">
                    <table class="zenith-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Items</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr class="zenith-table-row">
                                    <td>
                                        <div class="zenith-order-number">@order.OrderNumber</div>
                                    </td>
                                    <td>
                                        <div class="zenith-customer-info">
                                            <div class="zenith-customer-name">@order.FullCustomerName</div>
                                            <div class="zenith-customer-city">@order.City</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="zenith-date-info">
                                            <div class="zenith-date">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                            <div class="zenith-time">@order.OrderDate.ToString("HH:mm")</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="zenith-amount">@order.TotalAmount.ToString("C")</div>
                                    </td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case OrderStatus.Pending:
                                                <span class="zenith-badge zenith-badge-warning">Pending</span>
                                                break;
                                            case OrderStatus.Confirmed:
                                                <span class="zenith-badge zenith-badge-info">Confirmed</span>
                                                break;
                                            case OrderStatus.Shipped:
                                                <span class="zenith-badge zenith-badge-primary">Shipped</span>
                                                break;
                                            case OrderStatus.Delivered:
                                                <span class="zenith-badge zenith-badge-success">Delivered</span>
                                                break;
                                            case OrderStatus.Cancelled:
                                                <span class="zenith-badge zenith-badge-danger">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <span class="zenith-badge zenith-badge-secondary">@order.OrderItems.Count items</span>
                                    </td>
                                    <td>
                                        <div class="zenith-action-buttons">
                                            <a asp-action="Detail" asp-route-id="@order.Id" 
                                               class="zenith-btn zenith-btn-sm zenith-btn-outline" 
                                               title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="zenith-pagination-wrapper">
                        <nav class="zenith-pagination">
                            @if (Model.CurrentPage > 1)
                            {
                                <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1, status = Model.StatusFilter })" 
                                   class="zenith-pagination-btn zenith-pagination-prev">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            }
                            
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <a href="@Url.Action("Index", new { page = i, status = Model.StatusFilter })" 
                                   class="zenith-pagination-btn @(i == Model.CurrentPage ? "zenith-pagination-active" : "")">
                                    @i
                                </a>
                            }
                            
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1, status = Model.StatusFilter })" 
                                   class="zenith-pagination-btn zenith-pagination-next">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            }
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="zenith-empty-state">
                    <div class="zenith-empty-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h4 class="zenith-empty-title">No Orders Found</h4>
                    <p class="zenith-empty-description">There are no orders matching your criteria.</p>
                </div>
            }
        </div>
    </div>
</div>