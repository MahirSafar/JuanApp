@model ShopIndexViewModel
@{
    ViewData["Title"] = "Shop";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .shop-page {
            padding: 60px 0;
            background: #0a0a0a;
            min-height: 100vh;
        }

        .shop-sidebar {
            background: #1a1a1a;
            border-radius: 15px;
            padding: 30px;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .filter-section {
            margin-bottom: 30px;
            padding-bottom: 25px;
            border-bottom: 1px solid #333;
        }

        .filter-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

        .filter-title {
            color: #ffd700;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .color-option {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2px solid #333;
            cursor: pointer;
            position: relative;
            transition: all 0.3s ease;
        }

        .color-option:hover,
        .color-option.selected {
            border-color: #1de9b6;
            transform: scale(1.1);
        }

        .color-option.selected::after {
            content: '✓';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-weight: bold;
            text-shadow: 1px 1px 1px rgba(0,0,0,0.8);
        }

        .size-option {
            background: #2a2a2a;
            border: 1px solid #444;
            color: #fff;
            padding: 8px 15px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
            font-weight: 500;
        }

        .size-option:hover,
        .size-option.selected {
            background: #1de9b6;
            border-color: #1de9b6;
            color: #0a0a0a;
        }

        .price-range-slider {
            margin: 20px 0;
        }

        .price-display {
            color: #1de9b6;
            font-weight: 600;
            text-align: center;
            margin-top: 10px;
        }

        .shop-header {
            background: #1a1a1a;
            border-radius: 15px;
            padding: 20px 30px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .results-info {
            color: #ccc;
            font-size: 16px;
        }

        .shop-controls {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .view-mode-toggle {
            display: flex;
            background: #2a2a2a;
            border-radius: 8px;
            overflow: hidden;
        }

        .view-toggle-btn {
            background: none;
            border: none;
            color: #ccc;
            padding: 10px 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .view-toggle-btn.active {
            background: #1de9b6;
            color: #0a0a0a;
        }

        .sort-select {
            background: #2a2a2a;
            border: 1px solid #444;
            color: #fff;
            padding: 10px 15px;
            border-radius: 8px;
            min-width: 200px;
        }

        .sort-select:focus {
            border-color: #1de9b6;
            outline: none;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .products-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 40px;
        }

        .product-card {
            background: #1a1a1a;
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
            position: relative;
            border: 1px solid #333;
        }

        .product-card:hover {
            transform: translateY(-10px);
            border-color: #1de9b6;
            box-shadow: 0 20px 40px rgba(29, 233, 182, 0.1);
        }

        .product-image {
            position: relative;
            overflow: hidden;
            height: 250px;
        }

        .list-view .product-image {
            height: 200px;
            width: 200px;
            flex-shrink: 0;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image img {
            transform: scale(1.1);
        }

        .product-badges {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 2;
        }

        .product-badge {
            background: #e91e63;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 5px;
            display: block;
        }

        .product-badge.new {
            background: #1de9b6;
            color: #0a0a0a;
        }

        .product-badge.sale {
            background: #ff6b35;
        }

        .product-actions {
            position: absolute;
            top: 15px;
            right: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            opacity: 0;
            transform: translateX(20px);
            transition: all 0.3s ease;
        }

        .product-card:hover .product-actions {
            opacity: 1;
            transform: translateX(0);
        }

        .action-btn {
            background: rgba(26, 26, 26, 0.9);
            border: none;
            color: #fff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .action-btn:hover {
            background: #1de9b6;
            color: #0a0a0a;
        }

        .product-info {
            padding: 20px;
        }

        .list-view .product-card {
            display: flex;
            align-items: center;
            padding: 20px;
        }

        .list-view .product-info {
            flex: 1;
            padding: 0 20px;
        }

        .product-category {
            color: #1de9b6;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .product-title {
            color: #fff;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 10px;
            line-height: 1.3;
        }

        .product-title:hover {
            color: #1de9b6;
        }

        .product-price {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .current-price {
            color: #ffd700;
            font-size: 20px;
            font-weight: 700;
        }

        .original-price {
            color: #888;
            font-size: 16px;
            text-decoration: line-through;
        }

        .product-stock {
            color: #1de9b6;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .product-stock.out-of-stock {
            color: #ff6b35;
        }

        .add-to-cart-btn {
            background: linear-gradient(135deg, #1de9b6, #17c2a3);
            border: none;
            color: #0a0a0a;
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
        }

        .add-to-cart-btn:hover:not(:disabled) {
            background: linear-gradient(135deg, #17c2a3, #1de9b6);
            transform: translateY(-2px);
        }

        .add-to-cart-btn:disabled {
            background: #666;
            color: #999;
            cursor: not-allowed;
        }

        .pagination-wrapper {
            display: flex;
            justify-content: center;
            margin-top: 40px;
        }

        .pagination {
            display: flex;
            list-style: none;
            padding: 0;
            margin: 0;
            gap: 5px;
        }

        .page-item {
            border-radius: 8px;
            overflow: hidden;
        }

        .page-link {
            background: #2a2a2a;
            border: 1px solid #444;
            color: #fff;
            padding: 12px 16px;
            text-decoration: none;
            transition: all 0.3s ease;
            display: block;
        }

        .page-link:hover {
            background: #1de9b6;
            color: #0a0a0a;
            border-color: #1de9b6;
        }

        .page-item.active .page-link {
            background: #1de9b6;
            color: #0a0a0a;
            border-color: #1de9b6;
        }

        .page-item.disabled .page-link {
            background: #1a1a1a;
            color: #666;
            cursor: not-allowed;
        }

        .filter-checkbox {
            margin-right: 10px;
        }

        .filter-label {
            color: #ccc;
            cursor: pointer;
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            transition: color 0.3s ease;
        }

        .filter-label:hover {
            color: #1de9b6;
        }

        .search-box {
            background: #2a2a2a;
            border: 1px solid #444;
            color: #fff;
            padding: 12px 15px;
            border-radius: 8px;
            width: 100%;
            margin-bottom: 20px;
        }

        .search-box:focus {
            border-color: #1de9b6;
            outline: none;
        }

        .clear-filters-btn {
            background: transparent;
            border: 1px solid #1de9b6;
            color: #1de9b6;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 20px;
        }

        .clear-filters-btn:hover {
            background: #1de9b6;
            color: #0a0a0a;
        }

        .no-products {
            text-align: center;
            color: #888;
            padding: 60px 20px;
            background: #1a1a1a;
            border-radius: 15px;
        }

        .no-products i {
            font-size: 48px;
            color: #444;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .shop-page {
                padding: 30px 0;
            }
            
            .shop-sidebar {
                margin-bottom: 30px;
                position: static;
            }
            
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 20px;
            }
            
            .shop-header {
                padding: 15px 20px;
            }
            
            .shop-controls {
                width: 100%;
                justify-content: space-between;
            }
            
            .list-view .product-card {
                flex-direction: column;
                text-align: center;
            }
            
            .list-view .product-image {
                width: 100%;
                height: 200px;
            }
        }
    </style>
}

<div class="shop-page">
    <div class="container">
        <div class="row">
            <!-- Sidebar Filters -->
            <div class="col-lg-3 col-md-4">
                <div class="shop-sidebar">
                    <form id="shopFilters" method="get" action="@Url.Action("Index")">
                        <!-- Search -->
                        <div class="filter-section">
                            <h5 class="filter-title">
                                <i class="fas fa-search"></i>
                                Search Products
                            </h5>
                            <input type="text" 
                                   name="SearchTerm" 
                                   value="@Model.Filters.SearchTerm" 
                                   class="search-box" 
                                   placeholder="Search products...">
                        </div>

                        <!-- Categories -->
                        <div class="filter-section">
                            <h5 class="filter-title">
                                <i class="fas fa-tags"></i>
                                Categories
                            </h5>
                            <div class="filter-options">
                                <label class="filter-label">
                                    <input type="radio" 
                                           name="CategoryId" 
                                           value="" 
                                           class="filter-checkbox"
                                           @(Model.Filters.CategoryId == null ? "checked" : "")>
                                    All Categories
                                </label>
                                @foreach (var category in Model.Categories)
                                {
                                    <label class="filter-label">
                                        <input type="radio" 
                                               name="CategoryId" 
                                               value="@category.Id" 
                                               class="filter-checkbox"
                                               @(Model.Filters.CategoryId == category.Id ? "checked" : "")>
                                        @category.Name
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Gender -->
                        <div class="filter-section">
                            <h5 class="filter-title">
                                <i class="fas fa-user"></i>
                                Gender
                            </h5>
                            <div class="filter-options">
                                <label class="filter-label">
                                    <input type="radio" 
                                           name="Gender" 
                                           value="" 
                                           class="filter-checkbox"
                                           @(string.IsNullOrEmpty(Model.Filters.Gender) ? "checked" : "")>
                                    All Genders
                                </label>
                                @foreach (var gender in new[] { "Men", "Women", "Kids", "Unisex" })
                                {
                                    <label class="filter-label">
                                        <input type="radio" 
                                               name="Gender" 
                                               value="@gender" 
                                               class="filter-checkbox"
                                               @(Model.Filters.Gender == gender ? "checked" : "")>
                                        @gender
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Colors -->
                        @if (Model.Colors.Any())
                        {
                            <div class="filter-section">
                                <h5 class="filter-title">
                                    <i class="fas fa-palette"></i>
                                    Colors
                                </h5>
                                <div class="row g-2">
                                    @foreach (var color in Model.Colors)
                                    {
                                        <div class="col-auto">
                                            <div class="color-option @(Model.Filters.ColorIds.Contains(color.Id) ? "selected" : "")" 
                                                 style="background-color: @color.HexCode"
                                                 data-color-id="@color.Id"
                                                 title="@color.Name">
                                            </div>
                                        </div>
                                    }
                                </div>
                                @foreach (var colorId in Model.Filters.ColorIds)
                                {
                                    <input type="hidden" name="ColorIds" value="@colorId" class="color-input">
                                }
                            </div>
                        }

                        <!-- Sizes -->
                        @if (Model.Sizes.Any())
                        {
                            <div class="filter-section">
                                <h5 class="filter-title">
                                    <i class="fas fa-ruler"></i>
                                    Sizes
                                </h5>
                                <div class="row g-2">
                                    @foreach (var size in Model.Sizes)
                                    {
                                        <div class="col-auto">
                                            <div class="size-option @(Model.Filters.SizeIds.Contains(size.Id) ? "selected" : "")" 
                                                 data-size-id="@size.Id">
                                                @size.Size
                                            </div>
                                        </div>
                                    }
                                </div>
                                @foreach (var sizeId in Model.Filters.SizeIds)
                                {
                                    <input type="hidden" name="SizeIds" value="@sizeId" class="size-input">
                                }
                            </div>
                        }

                        <!-- Price Range -->
                        <div class="filter-section">
                            <h5 class="filter-title">
                                <i class="fas fa-dollar-sign"></i>
                                Price Range
                            </h5>
                            <div class="price-range-slider">
                                <div id="priceRange"></div>
                                <div class="price-display">
                                    <span id="priceDisplay">$@(ViewBag.MinPrice) - $@(ViewBag.MaxPrice)</span>
                                </div>
                                <input type="hidden" name="MinPrice" value="@Model.Filters.MinPrice" id="minPriceInput">
                                <input type="hidden" name="MaxPrice" value="@Model.Filters.MaxPrice" id="maxPriceInput">
                            </div>
                        </div>

                        <!-- Hidden inputs for other filters -->
                        <input type="hidden" name="SortBy" value="@Model.Filters.SortBy">
                        <input type="hidden" name="ViewMode" value="@Model.Filters.ViewMode">
                        <input type="hidden" name="PageSize" value="@Model.Filters.PageSize">

                        <button type="button" class="clear-filters-btn" onclick="clearAllFilters()">
                            <i class="fas fa-times me-2"></i>Clear All Filters
                        </button>
                    </form>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 col-md-8">
                <!-- Shop Header -->
                <div class="shop-header">
                    <div class="results-info">
                        Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) - @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalProducts)) of @Model.TotalProducts products
                    </div>
                    <div class="shop-controls">
                        <!-- Sort By -->
                        <select name="sortBy" id="sortSelect" class="sort-select">
                            <option value="newest" @(Model.Filters.SortBy == "newest" ? "selected" : "")>Newest First</option>
                            <option value="price-low-high" @(Model.Filters.SortBy == "price-low-high" ? "selected" : "")>Price: Low to High</option>
                            <option value="price-high-low" @(Model.Filters.SortBy == "price-high-low" ? "selected" : "")>Price: High to Low</option>
                            <option value="name-asc" @(Model.Filters.SortBy == "name-asc" ? "selected" : "")>Name: A to Z</option>
                            <option value="name-desc" @(Model.Filters.SortBy == "name-desc" ? "selected" : "")>Name: Z to A</option>
                        </select>

                        <!-- View Mode Toggle -->
                        <div class="view-mode-toggle">
                            <button type="button" 
                                    class="view-toggle-btn @(Model.ViewMode == "grid-view" ? "active" : "")" 
                                    data-view="grid-view">
                                <i class="fas fa-th"></i>
                            </button>
                            <button type="button" 
                                    class="view-toggle-btn @(Model.ViewMode == "list-view" ? "active" : "")" 
                                    data-view="list-view">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Products -->
                <div id="productsContainer" class="@(Model.ViewMode == "list-view" ? "products-list" : "products-grid")">
                    @if (Model.Products.Any())
                    {
                        @foreach (var product in Model.Products)
                        {
                            <div class="product-card">
                                <!-- Product Badges -->
                                <div class="product-badges">
                                    @if (product.IsOnSale)
                                    {
                                        <span class="product-badge sale">-@(product.Discount)%</span>
                                    }
                                    @if ((DateTime.Now - product.Id).Days <= 30) // Assuming new products are those created within 30 days
                                    {
                                        <span class="product-badge new">New</span>
                                    }
                                </div>

                                <!-- Product Actions -->
                                <div class="product-actions">
                                    <button class="action-btn" onclick="quickView(@product.Id)" title="Quick View">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="action-btn" onclick="addToWishlist(@product.Id)" title="Add to Wishlist">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                </div>

                                <!-- Product Image -->
                                <div class="product-image">
                                    <a href="@Url.Action("Detail", "Product", new { id = product.Id })">
                                        <img src="@(!string.IsNullOrEmpty(product.MainImageUrl) ? "/uploads/products/" + product.MainImageUrl : "/assets/images/no-image.jpg")" 
                                             alt="@product.Name">
                                    </a>
                                </div>

                                <!-- Product Info -->
                                <div class="product-info">
                                    <div class="product-category">@product.CategoryName</div>
                                    <h5 class="product-title">
                                        <a href="@Url.Action("Detail", "Product", new { id = product.Id })">
                                            @product.Name
                                        </a>
                                    </h5>
                                    <div class="product-price">
                                        <span class="current-price">$@product.DiscountedPrice.ToString("F2")</span>
                                        @if (product.IsOnSale)
                                        {
                                            <span class="original-price">$@product.Price.ToString("F2")</span>
                                        }
                                    </div>
                                    <div class="product-stock @(product.IsInStock ? "" : "out-of-stock")">
                                        @if (product.IsInStock)
                                        {
                                            <i class="fas fa-check-circle me-1"></i>
                                            <span>@product.Stock in stock</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times-circle me-1"></i>
                                            <span>Out of stock</span>
                                        }
                                    </div>
                                    <button class="add-to-cart-btn" 
                                            onclick="addToCart(@product.Id)" 
                                            @(product.IsInStock ? "" : "disabled")>
                                        @if (product.IsInStock)
                                        {
                                            <i class="fas fa-shopping-cart me-2"></i>
                                            <span>Add to Cart</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times me-2"></i>
                                            <span>Out of Stock</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-products">
                            <i class="fas fa-search"></i>
                            <h3>No products found</h3>
                            <p>Try adjusting your filters or search terms to find what you're looking for.</p>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="pagination-wrapper">
                        <ul class="pagination">
                            <!-- Previous Page -->
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" href="@(Model.HasPreviousPage ? Url.Action("Index", GetRouteValues(Model.CurrentPage - 1)) : "#")">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>

                            <!-- Page Numbers -->
                            @{
                                int startPage = Math.Max(1, Model.CurrentPage - 2);
                                int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", GetRouteValues(1))">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", GetRouteValues(i))">@i</a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", GetRouteValues(Model.TotalPages))">@Model.TotalPages</a>
                                </li>
                            }

                            <!-- Next Page -->
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" href="@(Model.HasNextPage ? Url.Action("Index", GetRouteValues(Model.CurrentPage + 1)) : "#")">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-gold">Quick View</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="quickViewContent">
                <!-- Quick view content will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.1/themes/ui-lightness/jquery-ui.css">
    
    <script>
        $(document).ready(function() {
            // Initialize price range slider
            initializePriceRange();
            
            // Color filter functionality
            $('.color-option').click(function() {
                var colorId = $(this).data('color-id');
                var isSelected = $(this).hasClass('selected');
                
                if (isSelected) {
                    $(this).removeClass('selected');
                    $('input[name="ColorIds"][value="' + colorId + '"]').remove();
                } else {
                    $(this).addClass('selected');
                    $('#shopFilters').append('<input type="hidden" name="ColorIds" value="' + colorId + '" class="color-input">');
                }
            });
            
            // Size filter functionality
            $('.size-option').click(function() {
                var sizeId = $(this).data('size-id');
                var isSelected = $(this).hasClass('selected');
                
                if (isSelected) {
                    $(this).removeClass('selected');
                    $('input[name="SizeIds"][value="' + sizeId + '"]').remove();
                } else {
                    $(this).addClass('selected');
                    $('#shopFilters').append('<input type="hidden" name="SizeIds" value="' + sizeId + '" class="size-input">');
                }
            });
            
            // Sort functionality
            $('#sortSelect').change(function() {
                $('input[name="SortBy"]').val($(this).val());
                $('#shopFilters').submit();
            });
            
            // View mode toggle
            $('.view-toggle-btn').click(function() {
                var viewMode = $(this).data('view');
                $('.view-toggle-btn').removeClass('active');
                $(this).addClass('active');
                
                $('input[name="ViewMode"]').val(viewMode);
                
                if (viewMode === 'list-view') {
                    $('#productsContainer').removeClass('products-grid').addClass('products-list');
                } else {
                    $('#productsContainer').removeClass('products-list').addClass('products-grid');
                }
                
                // Save to session
                $.post('@Url.Action("SetViewMode")', { viewMode: viewMode });
            });
            
            // Auto-submit form on filter change
            $('input[name="CategoryId"], input[name="Gender"], input[name="SearchTerm"]').change(function() {
                // Reset to first page when filters change
                var form = $('#shopFilters');
                form.append('<input type="hidden" name="Page" value="1">');
                setTimeout(function() {
                    form.submit();
                }, 300);
            });
            
            // Search input with delay
            var searchTimeout;
            $('input[name="SearchTerm"]').on('input', function() {
                clearTimeout(searchTimeout);
                var form = $('#shopFilters');
                searchTimeout = setTimeout(function() {
                    form.append('<input type="hidden" name="Page" value="1">');
                    form.submit();
                }, 500);
            });
        });
        
        function initializePriceRange() {
            var minPrice = @ViewBag.MinPrice;
            var maxPrice = @ViewBag.MaxPrice;
            var currentMin = @(Model.Filters.MinPrice ?? ViewBag.MinPrice);
            var currentMax = @(Model.Filters.MaxPrice ?? ViewBag.MaxPrice);
            
            $("#priceRange").slider({
                range: true,
                min: minPrice,
                max: maxPrice,
                values: [currentMin, currentMax],
                slide: function(event, ui) {
                    $("#priceDisplay").text("$" + ui.values[0] + " - $" + ui.values[1]);
                },
                change: function(event, ui) {
                    $("#minPriceInput").val(ui.values[0]);
                    $("#maxPriceInput").val(ui.values[1]);
                    
                    // Submit form after price change
                    setTimeout(function() {
                        var form = $('#shopFilters');
                        form.append('<input type="hidden" name="Page" value="1">');
                        form.submit();
                    }, 500);
                }
            });
            
            $("#priceDisplay").text("$" + currentMin + " - $" + currentMax);
        }
        
        function clearAllFilters() {
            window.location.href = '@Url.Action("Index")';
        }
        
        function quickView(productId) {
            $.get('@Url.Action("QuickView")/' + productId, function(data) {
                $('#quickViewContent').html(data);
                $('#quickViewModal').modal('show');
            });
        }
        
        function addToCart(productId) {
            // Implement add to cart functionality
            console.log('Add to cart:', productId);
            // You can make an AJAX call to add the product to cart
        }
        
        function addToWishlist(productId) {
            // Implement add to wishlist functionality
            console.log('Add to wishlist:', productId);
            // You can make an AJAX call to add the product to wishlist
        }
    </script>
}

@{
    object GetRouteValues(int page)
    {
        return new
        {
            SearchTerm = Model.Filters.SearchTerm,
            CategoryId = Model.Filters.CategoryId,
            Gender = Model.Filters.Gender,
            ColorIds = Model.Filters.ColorIds,
            SizeIds = Model.Filters.SizeIds,
            MinPrice = Model.Filters.MinPrice,
            MaxPrice = Model.Filters.MaxPrice,
            SortBy = Model.Filters.SortBy,
            ViewMode = Model.Filters.ViewMode,
            PageSize = Model.Filters.PageSize,
            Page = page
        };
    }
}