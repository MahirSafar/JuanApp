@model ReviewViewModel
@using JuanApp.Domain.Enums

@{
    ViewData["Title"] = "Review Details";
}

<div class="container-fluid">
<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Review Details</h1>
            <p class="text-muted">View and manage review information</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Reviews
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Review Information -->
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-comment me-2"></i>Review Information
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Product</h6>
                            <h5 class="text-primary">@Model.ProductName</h5>
                            <small class="text-muted">Product ID: @Model.ProductId</small>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Customer</h6>
                            <h5>@(!string.IsNullOrEmpty(Model.UserFullName) ? Model.UserFullName : Model.UserName)</h5>
                            <small class="text-muted">Username: @Model.UserName</small>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <h6 class="text-muted">Rating</h6>
                            <div class="rating-display">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Model.Rate)
                                    {
                                        <i class="fas fa-star text-warning fs-4"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted fs-4"></i>
                                    }
                                }
                                <span class="ms-2 fs-5 fw-bold">@Model.Rate/5</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Status</h6>
                            @switch (Model.Status)
                            {
                                case ReviewStatus.Pending:
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                        <i class="fas fa-clock me-1"></i>Pending
                                    </span>
                                    break;
                                case ReviewStatus.Approved:
                                    <span class="badge bg-success fs-6 px-3 py-2">
                                        <i class="fas fa-check me-1"></i>Approved
                                    </span>
                                    break;
                                case ReviewStatus.Rejected:
                                    <span class="badge bg-danger fs-6 px-3 py-2">
                                        <i class="fas fa-times me-1"></i>Rejected
                                    </span>
                                    break;
                            }
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-muted">Review ID</h6>
                            <span class="fw-bold">#@Model.Id</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted">Review Content</h6>
                        <div class="review-content-display p-3 bg-light rounded">
                            <p class="mb-0 fs-6">@Model.Content</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted">Created Date</h6>
                            <p class="mb-0">
                                <i class="fas fa-calendar me-2"></i>@Model.Created.ToString("MMMM dd, yyyy")
                                <br>
                                <i class="fas fa-clock me-2"></i>@Model.Created.ToString("HH:mm:ss")
                            </p>
                        </div>
                        @if (Model.LastModified.HasValue)
                        {
                            <div class="col-md-6">
                                <h6 class="text-muted">Last Modified</h6>
                                <p class="mb-0">
                                    <i class="fas fa-calendar me-2"></i>@Model.LastModified.Value.ToString("MMMM dd, yyyy")
                                    <br>
                                    <i class="fas fa-clock me-2"></i>@Model.LastModified.Value.ToString("HH:mm:ss")
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions Panel -->
        <div class="col-lg-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-cogs me-2"></i>Actions
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.Status == ReviewStatus.Pending)
                    {
                        <div class="d-grid gap-2 mb-3">
                            <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success" 
                                        onclick="return confirm('Are you sure you want to approve this review?')">
                                    <i class="fas fa-check me-2"></i>Approve Review
                                </button>
                            </form>
                            <form method="post" asp-action="Reject" asp-route-id="@Model.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning" 
                                        onclick="return confirm('Are you sure you want to reject this review?')">
                                    <i class="fas fa-times me-2"></i>Reject Review
                                </button>
                            </form>
                        </div>
                        <hr>
                    }

                    <div class="d-grid gap-2">
                        <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger" 
                                    onclick="return confirm('Are you sure you want to delete this review? This action cannot be undone.')">
                                <i class="fas fa-trash me-2"></i>Delete Review
                            </button>
                        </form>
                    </div>

                    <hr>

                    <div class="text-center">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            All actions are permanent and cannot be undone.
                        </small>
                    </div>
                </div>
            </div>

            <!-- Review Statistics (if you want to show some context) -->
            <div class="card shadow mt-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-chart-bar me-2"></i>Quick Info
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="border-end">
                                <h6 class="text-muted mb-1">Review ID</h6>
                                <h4 class="mb-0">#@Model.Id</h4>
                            </div>
                        </div>
                        <div class="col-6">
                            <h6 class="text-muted mb-1">Rating</h6>
                            <h4 class="mb-0 text-warning">@Model.Rate<small class="text-muted">/5</small></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rating-display {
        display: flex;
        align-items: center;
    }
    
    .review-content-display {
        border-left: 4px solid #007bff;
        line-height: 1.6;
    }
    
    .card {
        border: 0;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15) !important;
    }
    
    .badge {
        font-size: 0.875em;
    }
</style>