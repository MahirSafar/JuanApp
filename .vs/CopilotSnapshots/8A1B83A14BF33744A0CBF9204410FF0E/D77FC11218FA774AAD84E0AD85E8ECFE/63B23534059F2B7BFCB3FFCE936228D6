@model PaginatedList<ReviewViewModel>
@using JuanApp.Domain.Enums

@{
    ViewData["Title"] = ViewBag.Title ?? "Reviews Management";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
            <p class="text-muted">Manage product reviews and customer feedback</p>
        </div>
        <div>
            <a href="@Url.Action("Pending")" class="btn btn-warning">
                <i class="fas fa-clock me-2"></i>Pending Reviews
            </a>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter me-2"></i>Filters
            </h6>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var status in ViewBag.Statuses as SelectList)
                        {
                            <option value="@status.Value" selected="@(status.Value == ViewBag.CurrentStatus?.ToString())">
                                @status.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Product</label>
                    <select name="productId" class="form-select">
                        <option value="">All Products</option>
                        @foreach (var product in ViewBag.Products as SelectList)
                        {
                            <option value="@product.Value" selected="@(product.Value == ViewBag.CurrentProductId?.ToString())">
                                @product.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Search</label>
                    <input type="text" name="searchTerm" class="form-control" 
                           placeholder="Search by content or user..." value="@ViewBag.CurrentSearchTerm">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search"></i> Filter
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Reviews Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-comments me-2"></i>Reviews (@Model.TotalItems)
            </h6>
        </div>
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>User</th>
                                <th>Rating</th>
                                <th>Content</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var review in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-primary">@review.ProductName</div>
                                        <small class="text-muted">ID: @review.ProductId</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@(!string.IsNullOrEmpty(review.UserFullName) ? review.UserFullName : review.UserName)</div>
                                        <small class="text-muted">@review.UserName</small>
                                    </td>
                                    <td>
                                        <div class="rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rate)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted"></i>
                                                }
                                            }
                                        </div>
                                        <small class="text-muted">(@review.Rate/5)</small>
                                    </td>
                                    <td>
                                        <div class="review-content">
                                            @if (review.Content.Length > 100)
                                            {
                                                <span>@review.Content.Substring(0, 100)...</span>
                                                <a href="@Url.Action("Detail", new { id = review.Id })" class="text-primary">
                                                    <small>Read more</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <span>@review.Content</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @switch (review.Status)
                                        {
                                            case ReviewStatus.Pending:
                                                <span class="badge bg-warning text-dark">
                                                    <i class="fas fa-clock me-1"></i>Pending
                                                </span>
                                                break;
                                            case ReviewStatus.Approved:
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check me-1"></i>Approved
                                                </span>
                                                break;
                                            case ReviewStatus.Rejected:
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times me-1"></i>Rejected
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div>@review.Created.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@review.Created.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Detail", new { id = review.Id })" 
                                               class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            
                                            @if (review.Status == ReviewStatus.Pending)
                                            {
                                                <form method="post" asp-action="Approve" asp-route-id="@review.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success" 
                                                            title="Approve Review" onclick="return confirm('Are you sure you want to approve this review?')">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                                <form method="post" asp-action="Reject" asp-route-id="@review.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" 
                                                            title="Reject Review" onclick="return confirm('Are you sure you want to reject this review?')">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            }
                                            
                                            <form method="post" asp-action="Delete" asp-route-id="@review.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                        title="Delete Review" onclick="return confirm('Are you sure you want to delete this review? This action cannot be undone.')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Reviews pagination">
                        <ul class="pagination justify-content-center mt-4">
                            @if (Model.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        page = 1, 
                                        status = ViewBag.CurrentStatus, 
                                        productId = ViewBag.CurrentProductId, 
                                        searchTerm = ViewBag.CurrentSearchTerm 
                                    })">First</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        page = Model.PageIndex - 1, 
                                        status = ViewBag.CurrentStatus, 
                                        productId = ViewBag.CurrentProductId, 
                                        searchTerm = ViewBag.CurrentSearchTerm 
                                    })">Previous</a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        page = i, 
                                        status = ViewBag.CurrentStatus, 
                                        productId = ViewBag.CurrentProductId, 
                                        searchTerm = ViewBag.CurrentSearchTerm 
                                    })">@i</a>
                                </li>
                            }

                            @if (Model.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        page = Model.PageIndex + 1, 
                                        status = ViewBag.CurrentStatus, 
                                        productId = ViewBag.CurrentProductId, 
                                        searchTerm = ViewBag.CurrentSearchTerm 
                                    })">Next</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        page = Model.TotalPages, 
                                        status = ViewBag.CurrentStatus, 
                                        productId = ViewBag.CurrentProductId, 
                                        searchTerm = ViewBag.CurrentSearchTerm 
                                    })">Last</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                    <h5>No reviews found</h5>
                    <p class="text-muted">No reviews match your current filters.</p>
                    <a href="@Url.Action("Index")" class="btn btn-primary">
                        <i class="fas fa-refresh me-2"></i>View All Reviews
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .review-content {
        max-width: 300px;
        word-wrap: break-word;
    }
    
    .rating {
        display: inline-block;
    }
    
    .btn-group .btn {
        margin-right: 2px;
    }
    
    .table td {
        vertical-align: middle;
    }
</style>