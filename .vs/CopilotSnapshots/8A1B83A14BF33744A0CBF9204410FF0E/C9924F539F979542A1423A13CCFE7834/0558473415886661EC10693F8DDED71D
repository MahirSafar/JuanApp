@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            console.log('Product detail page loaded');
            // Initialize page
            initializeProductDetail();
            initializeReviewFunctionality();
        });
        
        function initializeProductDetail() {
            console.log('Initializing product detail functionality');
            
            // Image gallery functionality - Fixed version
            $('.thumbnail-image').off('click').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                console.log('Thumbnail clicked');
                
                const $thumbnail = $(this);
                let newImageSrc = $thumbnail.data('image');
                console.log('Original image source:', newImageSrc);
                
                // Ensure we have a valid image source
                if (!newImageSrc || newImageSrc.trim() === '') {
                    console.error('No valid image source found in data-image attribute');
                    showToast('Invalid image source', 'error');
                    return;
                }
                
                // Normalize the image path - remove any tilde if present and ensure proper path
                if (newImageSrc.startsWith('~/')) {
                    newImageSrc = newImageSrc.substring(1); // Remove the tilde
                }
                
                // Ensure the path starts with forward slash
                if (!newImageSrc.startsWith('/')) {
                    newImageSrc = '/' + newImageSrc;
                }
                
                console.log('Normalized image source:', newImageSrc);
                
                // Update active thumbnail immediately for better UX
                $('.thumbnail-item').removeClass('active');
                $thumbnail.closest('.thumbnail-item').addClass('active');
                
                // Update main image with fade effect
                const $mainImage = $('#mainProductImage');
                if ($mainImage.length) {
                    console.log('Updating main image...');
                    
                    // Add loading class
                    $mainImage.addClass('loading');
                    
                    // Create a new image to test if it loads
                    const testImg = new Image();
                    
                    testImg.onload = function() {
                        console.log('Image loaded successfully:', newImageSrc);
                        // Image loaded successfully, now update the main image
                        $mainImage.fadeOut(200, function() {
                            $(this).attr('src', newImageSrc)
                                  .removeClass('loading')
                                  .fadeIn(200);
                        });
                    };
                    
                    testImg.onerror = function() {
                        console.error('Failed to load image:', newImageSrc);
                        
                        // Try alternative path formats
                        const alternativePaths = [
                            '/uploads/products/' + newImageSrc.split('/').pop(), // Just filename
                            '~/uploads/products/' + newImageSrc.split('/').pop(), // With tilde
                            newImageSrc.replace('/uploads/products/', '/wwwroot/uploads/products/'), // With wwwroot
                        ];
                        
                        console.log('Trying alternative paths:', alternativePaths);
                        
                        let pathIndex = 0;
                        const tryAlternativePath = () => {
                            if (pathIndex < alternativePaths.length) {
                                const altPath = alternativePaths[pathIndex];
                                console.log('Trying alternative path:', altPath);
                                
                                const altImg = new Image();
                                altImg.onload = function() {
                                    console.log('Alternative path loaded successfully:', altPath);
                                    $mainImage.fadeOut(200, function() {
                                        $(this).attr('src', altPath)
                                              .removeClass('loading')
                                              .fadeIn(200);
                                    });
                                };
                                altImg.onerror = function() {
                                    pathIndex++;
                                    tryAlternativePath();
                                };
                                altImg.src = altPath;
                            } else {
                                // All paths failed
                                console.error('All alternative paths failed');
                                $mainImage.removeClass('loading');
                                
                                // Revert to previous active thumbnail
                                $('.thumbnail-item').removeClass('active');
                                $('.thumbnail-item').first().addClass('active');
                                
                                showToast('Failed to load image. Please try again or contact support.', 'error');
                            }
                        };
                        
                        tryAlternativePath();
                    };
                    
                    // Start loading the image
                    testImg.src = newImageSrc;
                    
                } else {
                    console.error('Main image element not found');
                    showToast('Image display element not found', 'error');
                }
            });
            
            // Color selection
            $('.color-option').off('click').on('click', function() {
                console.log('Color option clicked');
                $('.color-option').removeClass('selected');
                $(this).addClass('selected');
                
                // Add animation
                $(this).addClass('slide-up');
                setTimeout(() => $(this).removeClass('slide-up'), 300);
            });
            
            // Size selection
            $('.size-option').off('click').on('click', function() {
                console.log('Size option clicked');
                $('.size-option').removeClass('selected');
                $(this).addClass('selected');
                
                // Add animation
                $(this).addClass('slide-up');
                setTimeout(() => $(this).removeClass('slide-up'), 300);
            });
            
            // Wishlist button
            $('.wishlist-btn').off('click').on('click', function() {
                const $btn = $(this);
                const $icon = $btn.find('i');
                
                if ($icon.hasClass('fas')) {
                    $icon.removeClass('fas').addClass('far');
                    $btn.html('<i class="far fa-heart"></i> Add to Wishlist');
                    showToast('Removed from wishlist', 'info');
                } else {
                    $icon.removeClass('far').addClass('fas');
                    $btn.html('<i class="fas fa-heart"></i> In Wishlist');
                    showToast('Added to wishlist!', 'success');
                }
            });
            
            // Compare button
            $('.compare-btn').off('click').on('click', function() {
                showToast('Added to compare list!', 'success');
            });
            
            // Debug: Log all thumbnail images
            console.log('Found thumbnail images:', $('.thumbnail-image').length);
            $('.thumbnail-image').each(function(index) {
                console.log('Thumbnail ' + index + ':', $(this).data('image'));
            });
        }
        
        // Quantity controls
        function increaseQuantity() {
            const $input = $('#productQuantity');
            const currentValue = parseInt($input.val()) || 1;
            const maxValue = parseInt($input.attr('max')) || 999;
            
            if (currentValue < maxValue) {
                $input.val(currentValue + 1);
                animateQuantityChange();
            }
        }
        
        function decreaseQuantity() {
            const $input = $('#productQuantity');
            const currentValue = parseInt($input.val()) || 1;
            
            if (currentValue > 1) {
                $input.val(currentValue - 1);
                animateQuantityChange();
            }
        }
        
        function animateQuantityChange() {
            const $input = $('#productQuantity');
            $input.addClass('slide-up');
            setTimeout(() => $input.removeClass('slide-up'), 300);
        }
        
        // Add to cart functionality
        function addToCart(productId) {
            console.log('Add to cart called for product:', productId);
            
            const quantity = $('#productQuantity').val() || 1;
            const selectedColor = $('.color-option.selected').data('color-id');
            const selectedSize = $('.size-option.selected').data('size-id');
            
            console.log('Cart data:', { productId, quantity, selectedColor, selectedSize });
            
            // Validation
            if ($('.color-option').length > 0 && !selectedColor) {
                showToast('Please select a color', 'warning');
                return;
            }
            
            if ($('.size-option').length > 0 && !selectedSize) {
                showToast('Please select a size', 'warning');
                return;
            }
            
            const $btn = $('.add-to-cart-btn');
            const originalHtml = $btn.html();
            
            // Show loading state
            $btn.addClass('loading').html('<i class="fas fa-spinner fa-spin"></i> <span>Adding...</span>');
            
            // Get CSRF token
            const token = $('input[name="__RequestVerificationToken"]').val();
            console.log('CSRF Token:', token ? 'Found' : 'Not found');
            
            // AJAX call to add to cart
            $.ajax({
                url: '/Basket/AddToBasket',
                type: 'POST',
                data: {
                    productId: productId,
                    quantity: quantity,
                    colorId: selectedColor,
                    sizeId: selectedSize,
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    console.log('Add to cart response:', response);
                    if (response && response.success) {
                        // Success state
                        $btn.removeClass('loading').addClass('success')
                            .html('<i class="fas fa-check"></i> <span>Added to Cart!</span>');
                        
                        // Show success message
                        showToast(response.message || 'Product added to cart successfully!', 'success');
                        
                        // Update cart count if basket manager exists
                        if (window.basketManager && typeof window.basketManager.updateBasketCount === 'function') {
                            window.basketManager.updateBasketCount();
                        }
                        
                        // Reset button after 3 seconds
                        setTimeout(function() {
                            $btn.removeClass('success').html(originalHtml);
                        }, 3000);
                        
                    } else {
                        // Error handling
                        $btn.removeClass('loading').html(originalHtml);
                        showToast(response.message || 'Failed to add product to cart', 'error');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Add to cart error:', error);
                    console.error('Response:', xhr.responseText);
                    $btn.removeClass('loading').html(originalHtml);
                    
                    let errorMessage = 'Failed to add product to cart. Please try again.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    
                    showToast(errorMessage, 'error');
                }
            });
        }
        
        // Toast notification function
        function showToast(message, type = 'info') {
            const icon = {
                'success': 'success',
                'error': 'error',
                'warning': 'warning',
                'info': 'info'
            }[type] || 'info';
            
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: icon,
                    title: message,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer)
                        toast.addEventListener('mouseleave', Swal.resumeTimer)
                    }
                });
            } else {
                // Fallback to alert if SweetAlert2 is not available
                alert(message);
            }
        }
        
        // Image zoom functionality (click to enlarge)
        function initImageZoom() {
            $('#mainProductImage').off('click').on('click', function() {
                const imgSrc = $(this).attr('src');
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        imageUrl: imgSrc,
                        imageAlt: '@Model.Name',
                        showConfirmButton: false,
                        showCloseButton: true,
                        background: 'rgba(0,0,0,0.9)',
                        backdrop: 'rgba(0,0,0,0.8)',
                        customClass: {
                            image: 'img-fluid'
                        }
                    });
                }
            });
        }
        
        // Initialize image zoom
        $(document).ready(function() {
            initImageZoom();
        });

        // Review Functionality
        function initializeReviewFunctionality() {
            console.log('Initializing review functionality');
            
            // Star rating functionality
            $('.star-rating .star').off('click').on('click', function() {
                const rating = $(this).data('rating');
                updateStarRating(rating);
                $('#ratingValue').val(rating);
            });

            $('.star-rating .star').off('mouseenter').on('mouseenter', function() {
                const rating = $(this).data('rating');
                highlightStars(rating);
            });

            $('.star-rating').off('mouseleave').on('mouseleave', function() {
                const currentRating = $('#ratingValue').val() || 0;
                updateStarRating(currentRating);
            });

            // Review form submission
            $('#reviewForm').off('submit').on('submit', function(e) {
                e.preventDefault();
                submitReview();
            });
        }

        function highlightStars(rating) {
            $('.star-rating .star').each(function(index) {
                const star = $(this);
                const starRating = star.data('rating');
                const icon = star.find('i');
                
                if (starRating <= rating) {
                    icon.removeClass('far').addClass('fas');
                    star.addClass('active');
                } else {
                    icon.removeClass('fas').addClass('far');
                    star.removeClass('active');
                }
            });
        }

        function updateStarRating(rating) {
            $('.star-rating .star').each(function(index) {
                const star = $(this);
                const starRating = star.data('rating');
                const icon = star.find('i');
                
                if (starRating <= rating) {
                    icon.removeClass('far').addClass('fas');
                    star.addClass('active');
                } else {
                    icon.removeClass('fas').addClass('far');
                    star.removeClass('active');
                }
            });
        }

        function submitReview() {
            const rating = $('#ratingValue').val();
            const content = $('#reviewContent').val();
            const productId = $('#productId').val();

            // Validation
            if (!rating || rating == 0) {
                showToast('Please select a rating', 'warning');
                return;
            }

            if (!content || content.trim().length < 10) {
                showToast('Please write at least 10 characters for your review', 'warning');
                return;
            }

            if (content.trim().length > 500) {
                showToast('Review content cannot exceed 500 characters', 'warning');
                return;
            }

            // Get CSRF token
            const token = $('input[name="__RequestVerificationToken"]').val();

            // Show loading state
            const $submitBtn = $('#reviewForm button[type="submit"]');
            const originalText = $submitBtn.html();
            $submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Submitting...');

            // Submit review
            $.ajax({
                url: '/Product/SubmitReview',
                type: 'POST',
                data: {
                    ProductId: productId,
                    Rate: rating,
                    Content: content.trim(),
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    console.log('Review submission response:', response);
                    
                    if (response.success) {
                        showToast(response.message, 'success');
                        
                        // Reset form
                        $('#reviewForm')[0].reset();
                        $('#ratingValue').val(0);
                        updateStarRating(0);
                        
                        // Hide review form and show success message
                        setTimeout(function() {
                            $('.write-review-section').fadeOut(300, function() {
                                $(this).replaceWith(`
                                    <div class="alert alert-success">
                                        <i class="fas fa-check-circle me-2"></i>
                                        Thank you for your review! It will be published after approval.
                                    </div>
                                `);
                            });
                        }, 2000);
                        
                    } else {
                        showToast(response.message || 'Failed to submit review', 'error');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Review submission error:', error);
                    console.error('Response:', xhr.responseText);
                    
                    let errorMessage = 'Failed to submit review. Please try again.';
                    
                    // Check if user is not authenticated
                    if (xhr.status === 401) {
                        errorMessage = 'Please log in to submit a review.';
                        setTimeout(function() {
                            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        }, 2000);
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    
                    showToast(errorMessage, 'error');
                },
                complete: function() {
                    // Reset button state
                    $submitBtn.prop('disabled', false).html(originalText);
                }
            });
        }
    </script>
}