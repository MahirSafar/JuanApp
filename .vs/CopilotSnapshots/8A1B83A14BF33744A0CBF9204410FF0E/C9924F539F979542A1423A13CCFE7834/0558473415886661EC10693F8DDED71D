@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}

<!-- Hidden form for CSRF token -->
<form style="display: none;">
    @Html.AntiForgeryToken()
</form>

<!-- Breadcrumb Section -->
<div class="breadcrumb-area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-wrap">
                    <nav aria-label="breadcrumb">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Product Detail Section -->
<div class="product-details-area section-padding">
    <div class="container">
        <div class="row">
            <!-- Product Images -->
            <div class="col-lg-6 col-md-6">
                <div class="product-details-img">
                    <div class="product-gallery">
                        <!-- Main Image -->
                        <div class="main-image-container mb-4">
                            @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                            {
                                <img id="mainProductImage" src="~/uploads/products/@Model.MainImageUrl" alt="@Model.Name" class="main-product-image img-fluid" />
                            }
                            else
                            {
                                <div class="no-image-placeholder">
                                    <i class="fas fa-image fa-4x text-muted"></i>
                                    <p class="text-muted mt-2">No image available</p>
                                </div>
                            }
                            @if (Model.IsOnSale)
                            {
                                <span class="product-badge sale-badge">-@Model.Discount% OFF</span>
                            }
                            @if (!Model.IsInStock)
                            {
                                <span class="product-badge stock-badge">OUT OF STOCK</span>
                            }
                        </div>
                        
                        <!-- Thumbnail Images -->
                        @if (Model.ProductImages.Any() || !string.IsNullOrEmpty(Model.MainImageUrl))
                        {
                            <div class="thumbnail-gallery">
                                <div class="row g-2">
                                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                                    {
                                        <div class="col-3">
                                            <div class="thumbnail-item active" title="Main Image">
                                                <img src="~/uploads/products/@Model.MainImageUrl" alt="@Model.Name Main" class="thumbnail-image" data-image="/uploads/products/@Model.MainImageUrl" />
                                            </div>
                                        </div>
                                    }
                                    @foreach (var image in Model.ProductImages.Take(3))
                                    {
                                        <div class="col-3">
                                            <div class="thumbnail-item" title="Product Image @(Model.ProductImages.ToList().IndexOf(image) + 1)">
                                                <img src="~/uploads/products/@image.ImageUrl" alt="@Model.Name - Image @(Model.ProductImages.ToList().IndexOf(image) + 1)" class="thumbnail-image" data-image="/uploads/products/@image.ImageUrl" />
                                            </div>
                                        </div>
                                    }
                                    
                                    @* Add placeholder thumbnails if we have less than 4 images *@
                                    @{
                                        var totalImages = 1 + Model.ProductImages.Take(3).Count(); // Main image + additional images
                                        var placeholderCount = 4 - totalImages;
                                    }
                                    @for (int i = 0; i < placeholderCount; i++)
                                    {
                                        <div class="col-3">
                                            <div class="thumbnail-item placeholder-thumbnail">
                                                <div class="thumbnail-placeholder">
                                                    <i class="fas fa-image text-muted"></i>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <small class="text-muted mt-2 d-block">Click thumbnails to change main image</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Product Information -->
            <div class="col-lg-6 col-md-6">
                <div class="product-details-content">
                    <!-- Product Meta -->
                    <div class="product-meta mb-3">
                        <span class="category-badge">@Model.CategoryName</span>
                        <span class="gender-badge">@Model.Gender</span>
                    </div>
                    
                    <!-- Product Title -->
                    <h1 class="product-title">@Model.Name</h1>
                    
                    <!-- Product Rating (placeholder) -->
                    <div class="product-rating mb-3">
                        <div class="rating-stars">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                        </div>
                        <span class="rating-count">(4.5 / 24 reviews)</span>
                    </div>
                    
                    <!-- Product Price -->
                    <div class="product-price-section mb-4">
                        @if (Model.IsOnSale)
                        {
                            <div class="price-container">
                                <span class="current-price">$@Model.DiscountedPrice.ToString("F2")</span>
                                <span class="original-price">$@Model.Price.ToString("F2")</span>
                                <span class="save-amount">You save $@((Model.Price - Model.DiscountedPrice).ToString("F2"))</span>
                            </div>
                        }
                        else
                        {
                            <span class="current-price">$@Model.Price.ToString("F2")</span>
                        }
                    </div>
                    
                    <!-- Stock Status -->
                    <div class="stock-status mb-4">
                        @if (Model.IsInStock)
                        {
                            <span class="in-stock">
                                <i class="fas fa-check-circle"></i>
                                In Stock (@Model.Stock units available)
                            </span>
                        }
                        else
                        {
                            <span class="out-of-stock">
                                <i class="fas fa-times-circle"></i>
                                Out of Stock
                            </span>
                        }
                    </div>
                    
                    <!-- Product Description -->
                    <div class="product-description mb-4">
                        <p>@Model.Description</p>
                    </div>
                    
                    <!-- Product Options -->
                    <div class="product-options">
                        <!-- Colors -->
                        @if (Model.AvailableColors.Any())
                        {
                            <div class="option-group mb-4">
                                <h6 class="option-title">Available Colors:</h6>
                                <div class="color-options">
                                    @foreach (var color in Model.AvailableColors)
                                    {
                                        <div class="color-option" data-color-id="@color.Id" data-color-name="@color.Name">
                                            <span class="color-name">@color.Name</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        
                        <!-- Sizes -->
                        @if (Model.AvailableSizes.Any())
                        {
                            <div class="option-group mb-4">
                                <h6 class="option-title">Select Size:</h6>
                                <div class="size-options">
                                    @foreach (var size in Model.AvailableSizes)
                                    {
                                        <div class="size-option" data-size-id="@size.Id">
                                            <span class="size-value">@size.Size</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        
                        <!-- Quantity and Add to Cart -->
                        @if (Model.IsInStock)
                        {
                            <div class="cart-section">
                                <div class="quantity-cart-box">
                                    <div class="quantity-section">
                                        <span class="quantity-label">Quantity:</span>
                                        <div class="quantity-input">
                                            <button type="button" class="qty-btn minus" onclick="decreaseQuantity()">-</button>
                                            <input type="number" id="productQuantity" value="1" min="1" max="@Model.Stock" readonly>
                                            <button type="button" class="qty-btn plus" onclick="increaseQuantity()">+</button>
                                        </div>
                                    </div>
                                    <button type="button" class="add-to-cart-btn" onclick="addToCart(@Model.Id)">
                                        <i class="fas fa-shopping-cart"></i>
                                        <span class="btn-text">Add to Cart</span>
                                    </button>
                                </div>
                                
                            </div>
                        }
                        else
                        {
                            <div class="out-of-stock-section">
                                <button type="button" class="notify-btn" disabled>
                                    <i class="fas fa-bell"></i>
                                    Notify When Available
                                </button>
                            </div>
                        }
                    </div>
                    
                    <!-- Product Features -->
                    <div class="product-features mt-4">
                        <div class="feature-item">
                            <i class="fas fa-truck"></i>
                            <span>Free Shipping on orders over $50</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-undo-alt"></i>
                            <span>30-day return policy</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-shield-alt"></i>
                            <span>2-year warranty</span>
                        </div>
                    </div>
                    
                    <!-- Product Tags -->
                    @if (Model.Tags.Any())
                    {
                        <div class="product-tags-section mt-4">
                            <h6 class="tags-title">Tags:</h6>
                            <div class="tags-list">
                                @foreach (var tag in Model.Tags)
                                {
                                    <span class="product-tag">#@tag.Name</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

      
</div>

<!-- Product Tabs Section -->
<div class="product-tabs-area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="product-tabs">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#description" role="tab">Description</a>
                        </li>
                       
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#reviews" role="tab">Reviews (@Model.ReviewStatistics.TotalReviews)</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            <div class="description-content">
                                <p class="lead">@Model.Description</p>
                                <h5>Key Features:</h5>
                                <ul>
                                    <li>Premium quality materials</li>
                                    <li>Comfortable fit</li>
                                    <li>Durable construction</li>
                                    <li>Stylish design</li>
                                </ul>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="specifications" role="tabpanel">
                            <div class="specifications-content">
                                <table class="table table-striped">
                                    <tr>
                                        <td><strong>Category:</strong></td>
                                        <td>@Model.CategoryName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Gender:</strong></td>
                                        <td>@Model.Gender</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Available Colors:</strong></td>
                                        <td>@string.Join(", ", Model.AvailableColors.Select(c => c.Name))</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Available Sizes:</strong></td>
                                        <td>@string.Join(", ", Model.AvailableSizes.Select(s => s.Size))</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                            <div class="reviews-content">
                                <!-- Reviews Summary -->
                                @if (Model.ReviewStatistics.TotalReviews > 0)
                                {
                                    <div class="review-summary">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="average-rating">
                                                    <span class="rating-score">@Model.ReviewStatistics.AverageRating</span>
                                                    <div class="rating-stars">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            if (i <= Math.Floor(Model.ReviewStatistics.AverageRating))
                                                            {
                                                                <i class="fas fa-star"></i>
                                                            }
                                                            else if (i - Model.ReviewStatistics.AverageRating < 1)
                                                            {
                                                                <i class="fas fa-star-half-alt"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="far fa-star"></i>
                                                            }
                                                        }
                                                    </div>
                                                    <span class="total-reviews">Based on @Model.ReviewStatistics.TotalReviews review@(Model.ReviewStatistics.TotalReviews != 1 ? "s" : "")</span>
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="rating-breakdown">
                                                    @for (int i = 5; i >= 1; i--)
                                                    {
                                                        var count = i == 5 ? Model.ReviewStatistics.FiveStarCount :
                                                                   i == 4 ? Model.ReviewStatistics.FourStarCount :
                                                                   i == 3 ? Model.ReviewStatistics.ThreeStarCount :
                                                                   i == 2 ? Model.ReviewStatistics.TwoStarCount :
                                                                   Model.ReviewStatistics.OneStarCount;
                                                        var percentage = Model.ReviewStatistics.TotalReviews > 0 ? (count * 100.0 / Model.ReviewStatistics.TotalReviews) : 0;
                                                        
                                                        <div class="rating-bar">
                                                            <span class="star-label">@i star</span>
                                                            <div class="progress">
                                                                <div class="progress-bar bg-warning" style="width: @percentage%"></div>
                                                            </div>
                                                            <span class="count">@count</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Write Review Section -->
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    @if (!Model.HasUserReviewed)
                                    {
                                        <div class="write-review-section">
                                            <h5>Write a Review</h5>
                                            <form id="reviewForm">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" id="productId" value="@Model.Id" />
                                                
                                                <div class="rating-input mb-3">
                                                    <label class="form-label">Your Rating</label>
                                                    <div class="star-rating">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <span class="star" data-rating="@i">
                                                                <i class="far fa-star"></i>
                                                            </span>
                                                        }
                                                    </div>
                                                    <input type="hidden" id="ratingValue" name="Rate" value="0" />
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label for="reviewContent" class="form-label">Your Review</label>
                                                    <textarea class="form-control" id="reviewContent" name="Content" rows="4" 
                                                              placeholder="Share your thoughts about this product..." 
                                                              minlength="10" maxlength="500" required></textarea>
                                                    <div class="form-text">Minimum 10 characters, maximum 500 characters.</div>
                                                </div>
                                                
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fas fa-paper-plane me-2"></i>Submit Review
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="fas fa-info-circle me-2"></i>
                                            You have already reviewed this product. Thank you for your feedback!
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="login-to-review">
                                        <div class="alert alert-warning">
                                            <i class="fas fa-sign-in-alt me-2"></i>
                                            <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Detail", "Product", new { id = Model.Id }) })" class="alert-link">Login</a> 
                                            to write a review for this product.
                                        </div>
                                    </div>
                                }

                                <!-- Reviews List -->
                                @if (Model.Reviews.Any())
                                {
                                    <div class="reviews-list">
                                        <h5>Customer Reviews</h5>
                                        @foreach (var review in Model.Reviews)
                                        {
                                            <div class="review-item">
                                                <div class="review-header">
                                                    <div class="reviewer-info">
                                                        <strong>@(!string.IsNullOrEmpty(review.UserFullName) ? review.UserFullName : review.UserName)</strong>
                                                        <div class="review-rating">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                if (i <= review.Rate)
                                                                {
                                                                    <i class="fas fa-star text-warning"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-star text-muted"></i>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                    <span class="review-date">@review.Created.ToString("MMM dd, yyyy")</span>
                                                </div>
                                                <div class="review-content">
                                                    <p>@review.Content</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (Model.ReviewStatistics.TotalReviews == 0)
                                {
                                    <div class="no-reviews">
                                        <div class="text-center py-5">
                                            <i class="fas fa-star fa-3x text-muted mb-3"></i>
                                            <h5>No reviews yet</h5>
                                            <p class="text-muted">Be the first to review this product!</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Related Products -->
@if (Model.RelatedProducts.Any())
{
    <div class="related-products-area section-padding">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="section-title text-center">
                        <h2 class="title">Related Products</h2>
                        <p class="sub-title">You might also like these products</p>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var relatedProduct in Model.RelatedProducts)
                {
                    <div class="col-lg-3 col-md-6 col-sm-6">
                        <div class="product-item mb-50">
                            <div class="product-thumb">
                                @if (relatedProduct.IsOnSale)
                                {
                                    <span class="sale-badge">-@relatedProduct.Discount%</span>
                                }
                                <a href="@Url.Action("Detail", "Product", new { id = relatedProduct.Id })">
                                    @if (!string.IsNullOrEmpty(relatedProduct.MainImageUrl))
                                    {
                                        <img src="~/uploads/products/@relatedProduct.MainImageUrl" alt="@relatedProduct.Name" />
                                    }
                                    else
                                    {
                                        <div class="no-image-placeholder-small">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </a>
                            </div>
                            <div class="product-content">
                                <h5 class="product-name">
                                    <a href="@Url.Action("Detail", "Product", new { id = relatedProduct.Id })">@relatedProduct.Name</a>
                                </h5>
                                <div class="price-box">
                                    @if (relatedProduct.IsOnSale)
                                    {
                                        <span class="price-regular">$@relatedProduct.DiscountedPrice.ToString("F2")</span>
                                        <span class="price-old"><del>$@relatedProduct.Price.ToString("F2")</del></span>
                                    }
                                    else
                                    {
                                        <span class="price-regular">$@relatedProduct.Price.ToString("F2")</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
</div>

@section Styles {
    <style>
        /* === MODERN PRODUCT DETAIL STYLES === */
        
        /* Breadcrumb */
        .breadcrumb-area {
            background: #f8f9fa;
            padding: 20px 0;
        }
        
        .breadcrumb {
            background: none;
            margin-bottom: 0;
            padding: 0;
        }
        
        .breadcrumb-item a {
            color: #6c757d;
            text-decoration: none;
        }
        
        .breadcrumb-item.active {
            color: #495057;
            font-weight: 600;
        }
        
        /* Section Padding */
        .section-padding {
            padding: 80px 0;
        }
        
        .product-details-area {
            padding: 60px 0;
        }
        
        /* Product Gallery */
        .main-image-container {
            position: relative;
            overflow: hidden;
            border-radius: 15px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .main-product-image {
            width: 100%;
            height: 500px;
            object-fit: cover;
            transition: transform 0.3s ease;
            border-radius: 15px;
            cursor: zoom-in;
        }
        
        .main-product-image:hover {
            transform: scale(1.02);
        }
        
        .main-product-image.loading {
            opacity: 0.7;
        }
        
        .no-image-placeholder {
            height: 500px;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            border: 2px dashed #dee2e6;
        }
        
        .product-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 8px 16px;
            border-radius: 25px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            z-index: 10;
        }
        
        .sale-badge {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
        }
        
        .stock-badge {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            color: white;
        }
        
        /* Thumbnail Gallery */
        .thumbnail-gallery {
            margin-top: 20px;
        }
        
        .thumbnail-item {
            border-radius: 10px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 3px solid transparent;
            position: relative;
        }
        
        .thumbnail-item:hover {
            border-color: #007bff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,123,255,0.3);
        }
        
        .thumbnail-item.active {
            border-color: #28a745;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40,167,69,0.4);
        }
        
        .thumbnail-item.active::after {
            content: '✓';
            position: absolute;
            top: 5px;
            right: 5px;
            background: #28a745;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
        }
        
        .thumbnail-image {
            width: 100%;
            height: 80px;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }
        
        .thumbnail-item:hover .thumbnail-image {
            transform: scale(1.1);
        }
        
        /* Placeholder thumbnails */
        .placeholder-thumbnail {
            border: 2px dashed #dee2e6 !important;
            background: #f8f9fa;
            cursor: default;
        }
        
        .placeholder-thumbnail:hover {
            border-color: #dee2e6 !important;
            transform: none !important;
            box-shadow: none !important;
        }
        
        .thumbnail-placeholder {
            width: 100%;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        
        /* Product Content */
        .product-details-content {
            padding: 20px 0;
        }
        
        .product-meta {
            margin-bottom: 15px;
        }
        
        .category-badge,
        .gender-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-right: 10px;
        }
        
        .category-badge {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
        }
        
        .gender-badge {
            background: linear-gradient(135deg, #9b59b6, #8e44ad);
            color: white;
        }
        
        .product-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 20px;
            line-height: 1.2;
        }
        
        /* Product Rating */
        .product-rating {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .rating-stars {
            color: #f39c12;
            font-size: 18px;
        }
        
        .rating-count {
            color: #6c757d;
            font-size: 14px;
        }
        
        /* Price Section */
