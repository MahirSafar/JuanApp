@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="auth-header">
    <div class="auth-logo">
        <span class="auth-logo-icon">
            <i class="fas fa-gem"></i>
        </span>
        <span class="auth-logo-text">ZENITH</span>
    </div>
    <h1 class="auth-title">Welcome Back</h1>
    <p class="auth-subtitle">Enter your credentials to access your account</p>
</div>

<form class="auth-form" method="post" asp-action="Login" asp-controller="Account" asp-area="Manage">
    <div class="form-group">
        <label class="form-label" for="email">Email Address</label>
        <input type="email" class="form-control" id="email" name="Email" required autocomplete="email">
        <span class="validation-message" asp-validation-for="Email"></span>
    </div>

    <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input type="password" class="form-control" id="password" name="Password" required>
        <span class="validation-message" asp-validation-for="Password"></span>
    </div>

    <div class="form-check">
        <input type="checkbox" class="form-check-input" id="rememberMe" name="RememberMe">
        <label class="form-check-label" for="rememberMe">Keep me signed in</label>
    </div>

    <div asp-validation-summary="ModelOnly" class="validation-message"></div>

    <button type="submit" class="auth-btn">
        Sign In
    </button>

    <div class="auth-links">
        <a href="#" class="auth-link">Forgot Password?</a>
    </div>

    <div class="auth-divider">
        <span class="auth-divider-text">OR</span>
    </div>

    <div class="auth-links">
        <a href="/" class="auth-link">Back to Website</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}