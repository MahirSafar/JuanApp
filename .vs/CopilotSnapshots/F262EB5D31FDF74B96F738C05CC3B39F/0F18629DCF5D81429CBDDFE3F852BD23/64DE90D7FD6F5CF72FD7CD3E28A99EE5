@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zenith Admin Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Fira+Code:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/zenith-admin.css" />
</head>
<body>
    <div class="zenith-admin">
        <aside class="zenith-sidebar">
            <div class="zenith-logo">ZENITH</div>
            <nav class="zenith-nav">
                <a href="#" class="zenith-nav-item active"><span class="icon">🏠</span><span class="label">Dashboard</span></a>
                <a href="#" class="zenith-nav-item"><span class="icon">📊</span><span class="label">Analytics</span></a>
                <a href="#" class="zenith-nav-item"><span class="icon">👤</span><span class="label">Users</span></a>
                <a href="#" class="zenith-nav-item"><span class="icon">⚙️</span><span class="label">Settings</span></a>
            </nav>
        </aside>
        <main class="zenith-main">
            <header class="zenith-header">
                <div class="zenith-header-title">Admin Command Center</div>
                <div class="zenith-header-actions">
                    <span class="zenith-user">Welcome, Admin</span>
                </div>
            </header>
            <section class="zenith-content">
                @RenderBody()
            </section>
        </main>
    </div>
</body>
</html>