@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zenith Admin Panel</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Fira+Code:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/admin/css/zenith-admin.css" />
</head>
<body class="zenith-theme">
    <div class="zenith-admin-container">
        <!-- Sidebar -->
        <aside class="zenith-sidebar" id="sidebar">
            <div class="zenith-sidebar-header">
                <div class="zenith-logo">
                    <span class="zenith-logo-icon"><i class="fas fa-gem"></i></span>
                    <span class="zenith-logo-text">ZENITH</span>
                </div>
            </div>
            <nav class="zenith-nav">
                <a href="/manage/dashboard" class="zenith-nav-item"><i class="fas fa-chart-line"></i><span>Dashboard</span></a>
                <a href="/manage/analytics" class="zenith-nav-item"><i class="fas fa-chart-area"></i><span>Analytics</span></a>
                <a href="/manage/users" class="zenith-nav-item"><i class="fas fa-users"></i><span>Users</span></a>
                <a href="/manage/products" class="zenith-nav-item"><i class="fas fa-box"></i><span>Products</span></a>
                <a href="/manage/orders" class="zenith-nav-item"><i class="fas fa-shopping-cart"></i><span>Orders</span></a>
                <a href="/manage/settings" class="zenith-nav-item"><i class="fas fa-cog"></i><span>Settings</span></a>
                <a href="/manage/security" class="zenith-nav-item"><i class="fas fa-shield-alt"></i><span>Security</span></a>
            </nav>
            <div class="zenith-sidebar-footer">
                <div class="zenith-user-info">
                    <div class="zenith-user-avatar"><i class="fas fa-user"></i></div>
                    <div class="zenith-user-details">
                        <span class="zenith-user-name">Admin User</span>
                        <span class="zenith-user-role">System Admin</span>
                    </div>
                </div>
            </div>
        </aside>
        <!-- Main Content -->
        <main class="zenith-main">
            <header class="zenith-header">
                <button class="zenith-hamburger" id="hamburger" aria-label="Toggle sidebar">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>
                <div class="zenith-header-title">Dashboard</div>
                <div class="zenith-header-actions">
                    <button class="zenith-action-btn"><i class="fas fa-bell"></i><span class="zenith-badge">3</span></button>
                    <button class="zenith-action-btn"><i class="fas fa-search"></i></button>
                </div>
            </header>
            <section class="zenith-content">
                @RenderBody()
            </section>
        </main>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function() {
            $('#hamburger').on('click', function() {
                $('.zenith-admin-container').toggleClass('sidebar-collapsed');
            });
            // Highlight active nav item
            var currentPath = window.location.pathname.toLowerCase();
            $('.zenith-nav-item').each(function() {
                if (currentPath === $(this).attr('href').toLowerCase()) {
                    $(this).addClass('active');
                }
            });
        });
    </script>
</body>
</html>