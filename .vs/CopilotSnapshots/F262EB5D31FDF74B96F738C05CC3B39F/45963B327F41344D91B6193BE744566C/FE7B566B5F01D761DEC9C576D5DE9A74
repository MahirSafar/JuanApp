@model IEnumerable<SliderViewModel>

<div class="zenith-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="zenith-card-title">Sliders</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Slider
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Order</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="~/@item.ImageUrl" alt="@item.Title" style="width: 100px; height: 60px; object-fit: cover;" />
                        </td>
                        <td>@item.Title</td>
                        <td>@item.Order</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>@item.Created.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="btn-group">
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-info">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this slider?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .table {
            color: var(--text-main);
        }
        .table thead th {
            border-top: none;
            border-bottom: 2px solid var(--border);
            color: var(--gold);
        }
        .table td {
            border-color: var(--border);
            vertical-align: middle;
        }
        .btn-group {
            gap: 0.5rem;
        }
    </style>
}