@model SliderViewModel

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="zenith-card-title mb-2 fs-3">Create Slider</h2>
            <p class="text-muted mb-0">Add a new slider to your website</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-cyan rounded-pill px-4 py-2">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" class="row g-4">
        <div class="col-md-8 pe-4">
            <div class="form-group mb-4">
                <label asp-for="Title" class="form-label required fs-6 mb-2">Title</label>
                <input asp-for="Title" class="form-control form-control-lg bg-darker" placeholder="Enter title" />
                <span asp-validation-for="Title" class="text-danger mt-2 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="form-label fs-6 mb-2">Description</label>
                <textarea asp-for="Description" class="form-control form-control-lg bg-darker" rows="4" placeholder="Enter description"></textarea>
                <span asp-validation-for="Description" class="text-danger mt-2 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="RedirectUrl" class="form-label fs-6 mb-2">Redirect URL</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-darker border-end-0"><i class="fas fa-link"></i></span>
                    <input asp-for="RedirectUrl" class="form-control bg-darker border-start-0" placeholder="https://" />
                </div>
                <span asp-validation-for="RedirectUrl" class="text-danger mt-2 d-block"></span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="form-group mb-4">
                <label asp-for="ImageFile" class="form-label required fs-6 mb-2">Slider Image</label>
                <input asp-for="ImageFile" class="form-control form-control-lg bg-darker" accept="image/*" onchange="previewImage(this);" />
                <span asp-validation-for="ImageFile" class="text-danger mt-2 d-block"></span>
                <div class="mt-3">
                    <img id="imagePreview" src="#" alt="Preview" class="img-preview d-none rounded-4" />
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Order" class="form-label required fs-6 mb-2">Display Order</label>
                <input asp-for="Order" class="form-control form-control-lg bg-darker" type="number" min="0" placeholder="Enter order number" />
                <span asp-validation-for="Order" class="text-danger mt-2 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <div class="d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label ms-2 text-cyan">Active Status</label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-cyan btn-lg w-100 py-3 rounded-pill fw-semibold mt-4">
                <i class="fas fa-save me-2"></i>Create Slider
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            var preview = document.getElementById('imagePreview');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

@section Styles {
    <style>
        /* Card Styles */
        .zenith-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
        }

        /* Form Controls */
        .form-control {
            padding: 1rem 1.25rem;
            border: 2px solid var(--border);
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--cyan-teal);
            box-shadow: 0 0 0 0.25rem rgba(29, 233, 182, 0.15);
        }

        .bg-darker {
            background-color: rgba(0, 0, 0, 0.2) !important;
        }

        /* Labels */
        .form-label {
            color: var(--gold);
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .form-label.required:after {
            content: "*";
            color: #ff5252;
            margin-left: 4px;
        }

        /* Switch */
        .form-check-input {
            width: 3rem;
            height: 1.5rem;
            margin-top: 0;
        }

        .form-check-input:checked {
            background-color: var(--cyan-teal);
            border-color: var(--cyan-teal);
        }

        /* Image Preview */
        .img-preview {
            max-width: 100%;
            max-height: 200px;
            object-fit: cover;
            border: 2px solid var(--cyan-teal);
            background-color: rgba(0, 0, 0, 0.2);
        }

        /* Button */
        .btn-cyan {
            background: var(--cyan-teal);
            color: #000;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-cyan:hover {
            background: #13bfa6;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(29, 233, 182, 0.25);
        }

        /* Input Group */
        .input-group-text {
            border: 2px solid var(--border);
            color: var(--text-muted);
        }

        /* Validation */
        .text-danger {
            font-size: 0.875rem;
            margin-top: 0.5rem;
        }

        /* Spacing Utilities */
        .mb-4 { margin-bottom: 2rem !important; }
        .mb-5 { margin-bottom: 3rem !important; }
        .mt-4 { margin-top: 2rem !important; }
        .pe-4 { padding-right: 2rem !important; }
    </style>
}