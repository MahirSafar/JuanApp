@model SliderViewModel
@{
    ViewData["Title"] = "Slider Details";
}

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="zenith-card-title mb-1 fw-bold text-gold">Slider Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-cyan rounded-pill px-4 me-2">
                <i class="fas fa-edit me-2"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="position-relative rounded-4 overflow-hidden border-cyan bg-black p-2">
                <img src="~/@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm w-100" alt="@Model.Title" style="max-height: 320px; object-fit: cover;" />
                <div class="position-absolute top-0 end-0 m-3">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-cyan text-dark px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i>Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-section p-3">
                <h3 class="detail-title mb-4 text-gold fw-bold">@Model.Title</h3>
                <div class="detail-item mb-4">
                    <label class="detail-label">Description</label>
                    <p class="detail-value">@(Model.Description ?? "No description provided")</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.RedirectUrl))
                {
                    <div class="detail-item mb-4">
                        <label class="detail-label">Redirect URL</label>
                        <p class="detail-value">
                            <a href="@Model.RedirectUrl" target="_blank" class="text-cyan">
                                <i class="fas fa-external-link-alt me-1"></i>@Model.RedirectUrl
                            </a>
                        </p>
                    </div>
                }
                <div class="detail-item mb-4">
                    <label class="detail-label">Display Order</label>
                    <p class="detail-value">@Model.Order</p>
                </div>
                <div class="detail-item">
                    <label class="detail-label">Status</label>
                    <p class="detail-value">
                        @if (Model.IsActive)
                        {
                            <span class="text-cyan fw-bold"><i class="fas fa-check-circle me-1"></i>Active</span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .zenith-card {
            background: var(--card-bg, #181c24);
            border-radius: 1.5rem;
            box-shadow: 0 4px 32px rgba(0,0,0,0.25);
        }
        .zenith-card-title { color: var(--gold, #ffd700); }
        .btn-cyan, .btn-outline-cyan {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
            border: none;
        }
        .btn-outline-cyan {
            background: transparent;
            border: 2px solid var(--cyan-teal, #1de9b6);
            color: var(--cyan-teal, #1de9b6);
        }
        .btn-outline-cyan:hover, .btn-cyan:hover {
            background: #13bfa6;
            color: #fff;
        }
        .border-cyan { border-color: var(--cyan-teal, #1de9b6) !important; }
        .text-gold { color: var(--gold, #ffd700) !important; }
        .text-cyan { color: var(--cyan-teal, #1de9b6) !important; }
        .rounded-4 { border-radius: 1.5rem !important; }
        .shadow-lg { box-shadow: 0 8px 32px rgba(0,0,0,0.35) !important; }
        .detail-title { color: var(--gold, #ffd700); font-size: 1.5rem; font-weight: 600; }
        .detail-label { color: var(--cyan-teal, #1de9b6); font-size: 0.95rem; font-weight: 500; margin-bottom: 0.25rem; display: block; }
        .detail-value { color: var(--text-main, #fff); font-size: 1.1rem; margin-bottom: 0; }
        .img-fluid { border: 2px solid var(--cyan-teal, #1de9b6); background: #23272f; }
    </style>
}