@model IEnumerable<SliderViewModel>
@{
    ViewData["Title"] = "Sliders";
}

<div class="zenith-card p-5 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="zenith-card-title mb-2 fs-3">Manage Sliders</h2>
            <p class="text-muted mb-0">Control your website's slider content</p>
        </div>
        <a asp-action="Create" class="btn btn-cyan px-4 py-2 rounded-pill fw-semibold">
            <i class="fas fa-plus-circle me-2"></i>New Slider
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert custom-alert success mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert custom-alert danger mb-4">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive rounded-4 overflow-hidden">
        <table class="table align-middle custom-table mb-0">
            <thead>
                <tr>
                    <th class="py-3" style="width: 120px">Image</th>
                    <th class="py-3">Title</th>
                    <th class="py-3">Description</th>
                    <th class="py-3" style="width: 80px">Order</th>
                    <th class="py-3" style="width: 100px">Status</th>
                    <th class="py-3 text-end" style="width: 180px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(x => x.Order))
                {
                    <tr>
                        <td class="py-3">
                            <div class="slider-thumb">
                                <img src="~/@item.ImageUrl" alt="@item.Title" />
                            </div>
                        </td>
                        <td class="py-3">
                            <h6 class="mb-1 fw-bold">@item.Title</h6>
                            @if (!string.IsNullOrEmpty(item.RedirectUrl))
                            {
                                <a href="@item.RedirectUrl" target="_blank" class="text-cyan small">
                                    <i class="fas fa-link me-1"></i>@item.RedirectUrl
                                </a>
                            }
                        </td>
                        <td class="py-3">
                            <div class="text-truncate text-muted" style="max-width: 250px;">
                                @(item.Description ?? "-")
                            </div>
                        </td>
                        <td class="py-3 text-center fw-bold">@item.Order</td>
                        <td class="py-3">
                            @if (item.IsActive)
                            {
                                <span class="status-badge active">
                                    <i class="fas fa-check-circle me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <i class="fas fa-times-circle me-1"></i>Inactive
                                </span>
                            }
                        </td>
                        <td class="py-3 text-end">
                            <div class="action-buttons">
                                <a asp-action="Detail" asp-route-id="@item.Id" 
                                   class="btn btn-icon" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" 
                                   class="btn btn-icon" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-icon delete" 
                                        onclick="confirmDelete(@item.Id, '@item.Title')" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-5 text-center">
                            <i class="fas fa-image fa-3x mb-3 text-muted"></i>
                            <p class="text-muted mb-0">No sliders found. Create your first slider!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-0">
            <div class="modal-header border-bottom border-cyan-dark p-4">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Slider
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-0">Are you sure you want to delete the slider "<span id="sliderTitle" class="text-cyan fw-bold"></span>"?</p>
                <p class="text-muted small mt-2 mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-top border-cyan-dark p-4">
                <form asp-action="Delete" method="post" id="deleteForm">
                    <input type="hidden" name="id" id="sliderId" />
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-light px-4 py-2 me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4 py-2">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Table Styles */
        .custom-table {
            color: var(--text-main);
            border-collapse: separate;
            border-spacing: 0 0.5rem;
        }

        .custom-table thead th {
            background: var(--card-bg);
            color: var(--gold);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.875rem;
            letter-spacing: 0.5px;
            border: none;
        }

        .custom-table tbody tr {
            background: rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }

        .custom-table tbody tr:hover {
            background: rgba(29, 233, 182, 0.1);
        }

        .custom-table td {
            border: none;
            padding: 1rem;
            vertical-align: middle;
        }

        /* Slider Thumb */
        .slider-thumb {
            width: 100px;
            height: 60px;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid var(--cyan-teal);
        }

        .slider-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Status Badges */
        .status-badge {
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
        }

        .status-badge.active {
            background: rgba(29, 233, 182, 0.15);
            color: var(--cyan-teal);
        }

        .status-badge.inactive {
            background: rgba(255, 82, 82, 0.15);
            color: #ff5252;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
        }

        .btn-icon {
            width: 36px;
            height: 36px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            border: 2px solid var(--border);
            background: transparent;
            color: var(--cyan-teal);
            transition: all 0.3s ease;
        }

        .btn-icon:hover {
            border-color: var(--cyan-teal);
            background: var(--cyan-teal);
            color: #000;
        }

        .btn-icon.delete {
            color: #ff5252;
            border-color: var(--border);
        }

        .btn-icon.delete:hover {
            border-color: #ff5252;
            background: #ff5252;
            color: #fff;
        }

        /* Alert Styles */
        .custom-alert {
            border: none;
            border-radius: 12px;
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
        }

        .custom-alert.success {
            background: rgba(29, 233, 182, 0.15);
            color: var(--cyan-teal);
        }

        .custom-alert.danger {
            background: rgba(255, 82, 82, 0.15);
            color: #ff5252;
        }

        .custom-alert .btn-close {
            margin-left: auto;
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        /* Modal Styles */
        .modal-content {
            border-radius: 16px;
        }

        .border-cyan-dark {
            border-color: rgba(29, 233, 182, 0.2) !important;
        }
    </style>
}

@section Scripts {
    <script>
        function confirmDelete(id, title) {
            document.getElementById('sliderId').value = id;
            document.getElementById('sliderTitle').textContent = title;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.custom-alert').fadeOut('slow');
        }, 5000);
    </script>
}