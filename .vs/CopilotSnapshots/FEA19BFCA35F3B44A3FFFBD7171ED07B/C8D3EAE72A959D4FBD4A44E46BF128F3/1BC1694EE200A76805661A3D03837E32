@model ProductViewModel
@{
    ViewData["Title"] = "Product Details";
}

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="zenith-card-title mb-1 fw-bold text-gold">Product Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-cyan rounded-pill px-4 me-2">
                <i class="fas fa-edit me-2"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Product Images -->
            <div class="product-images-section mb-4">
                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                {
                    <div class="main-product-image mb-4">
                        <img src="~/uploads/products/@Model.MainImageUrl" alt="@Model.Name" class="img-fluid rounded-4 w-100" style="max-height: 500px; object-fit: cover;" />
                    </div>
                }
                
                @if (Model.ProductImages.Any())
                {
                    <div class="additional-images">
                        <h5 class="text-gold mb-3">
                            <i class="fas fa-images me-2"></i>Additional Images (@Model.ProductImages.Count)
                        </h5>
                        <div class="row g-3">
                            @foreach (var image in Model.ProductImages)
                            {
                                <div class="col-md-3 col-sm-4 col-6">
                                    <div class="additional-image-container">
                                        <img src="~/uploads/products/@image.ImageUrl" alt="@Model.Name" class="img-fluid rounded-3 additional-image" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <!-- Product Content -->
            <div class="product-detail-content">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-cyan fs-6 px-3 py-2">
                        <i class="fas fa-layer-group me-2"></i>@Model.CategoryName
                    </span>
                    <span class="badge @(Model.Gender == "Men" ? "bg-primary" : Model.Gender == "Women" ? "bg-pink" : "bg-success") fs-6 px-3 py-2">
                        <i class="fas fa-user me-2"></i>@Model.Gender
                    </span>
                </div>
                
                <h1 class="product-title text-gold fw-bold mb-3">@Model.Name</h1>
                
                <div class="product-pricing mb-4">
                    @if (Model.Discount > 0)
                    {
                        var discountedPrice = Model.Price - (Model.Price * Model.Discount / 100);
                        <div class="d-flex align-items-center gap-3">
                            <span class="current-price text-gold fw-bold fs-2">$@discountedPrice.ToString("F2")</span>
                            <span class="original-price text-muted text-decoration-line-through fs-4">$@Model.Price.ToString("F2")</span>
                            <span class="discount-badge bg-danger text-white px-3 py-1 rounded-pill">-@Model.Discount%</span>
                        </div>
                    }
                    else
                    {
                        <span class="current-price text-gold fw-bold fs-2">$@Model.Price.ToString("F2")</span>
                    }
                </div>
                
                <div class="product-description mb-4">
                    <h5 class="text-gold mb-3">
                        <i class="fas fa-info-circle me-2"></i>Description
                    </h5>
                    <p class="text-light lead">@Model.Description</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <!-- Product Information -->
            <div class="detail-section p-4 rounded-4 bg-dark border border-cyan mb-4">
                <h4 class="text-gold mb-3">
                    <i class="fas fa-info-circle me-2"></i>Product Information
                </h4>
                <div class="text-muted small">
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Product ID:</strong>
                        <span>#@Model.Id</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Category:</strong>
                        <span>@Model.CategoryName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Gender:</strong>
                        <span>@Model.Gender</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Stock:</strong>
                        <span class="@(Model.Stock > 0 ? "text-success" : "text-danger")">
                            @Model.Stock @(Model.Stock > 0 ? "units" : "(Out of Stock)")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Created:</strong>
                        <span>@Model.Created.ToString("MMM dd, yyyy")</span>
                    </div>
                    @if (Model.LastModified.HasValue)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <strong>Modified:</strong>
                            <span>@Model.LastModified.Value.ToString("MMM dd, yyyy")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between">
                        <strong>Total Images:</strong>
                        <span>@(Model.ProductImages.Count + 1)</span>
                    </div>
                </div>
            </div>
            
            <!-- Product Attributes -->
            @if (Model.SelectedColorIds.Any() || Model.SelectedSizeIds.Any() || Model.SelectedTagIds.Any())
            {
                <div class="detail-section p-4 rounded-4 bg-dark border border-warning mb-4">
                    <h5 class="text-warning mb-3">
                        <i class="fas fa-tags me-2"></i>Product Attributes
                    </h5>
                    
                    @if (Model.SelectedColorIds.Any())
                    {
                        <div class="attribute-group mb-3">
                            <strong class="text-light d-block mb-2">Available Colors:</strong>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var colorId in Model.SelectedColorIds)
                                {
                                    <span class="badge bg-secondary">Color #@colorId</span>
                                }
                            </div>
                        </div>
                    }
                    
                    @if (Model.SelectedSizeIds.Any())
                    {
                        <div class="attribute-group mb-3">
                            <strong class="text-light d-block mb-2">Available Sizes:</strong>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var sizeId in Model.SelectedSizeIds)
                                {
                                    <span class="badge bg-info">Size #@sizeId</span>
                                }
                            </div>
                        </div>
                    }
                    
                    @if (Model.SelectedTagIds.Any())
                    {
                        <div class="attribute-group">
                            <strong class="text-light d-block mb-2">Tags:</strong>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tagId in Model.SelectedTagIds)
                                {
                                    <span class="badge bg-success">Tag #@tagId</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            
            <!-- Quick Actions -->
            <div class="detail-section p-4 rounded-4 bg-dark border border-primary">
                <h5 class="text-primary mb-3">
                    <i class="fas fa-cogs me-2"></i>Quick Actions
                </h5>
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-cyan">
                        <i class="fas fa-edit me-2"></i>Edit Product
                    </a>
                    <button type="button" class="btn btn-outline-danger" 
                            data-product-id="@Model.Id" data-product-name="@Html.Raw(Html.Encode(Model.Name))" onclick="confirmDelete(this)">
                        <i class="fas fa-trash me-2"></i>Delete Product
                    </button>
                    <a asp-action="Create" class="btn btn-outline-success">
                        <i class="fas fa-plus me-2"></i>New Product
                    </a>
                    <button type="button" class="btn btn-outline-info" onclick="duplicateProduct(@Model.Id)">
                        <i class="fas fa-copy me-2"></i>Duplicate Product
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light border-cyan rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the product <span class="fw-bold text-gold">"<span id="ProductName"></span>"</span>?
                <div class="alert alert-warning mt-3 small">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone and will also delete all associated images and relationships.
                </div>
            </div>
            <div class="modal-footer border-0">
                <form asp-action="Delete" method="post" id="deleteForm">
                    <input type="hidden" name="id" id="ProductId" />
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .zenith-card {
            background: var(--card-bg, #181c24);
            border-radius: 1.5rem;
            box-shadow: 0 4px 32px rgba(0,0,0,0.25);
        }

        .zenith-card-title {
            color: var(--gold, #ffd700);
        }

        .btn-cyan, .btn-outline-cyan {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
            border: none;
        }

        .btn-outline-cyan {
            background: transparent;
            border: 2px solid var(--cyan-teal, #1de9b6);
            color: var(--cyan-teal, #1de9b6);
        }

            .btn-outline-cyan:hover, .btn-cyan:hover {
                background: #13bfa6;
                color: #fff;
            }

        .border-cyan {
            border-color: var(--cyan-teal, #1de9b6) !important;
        }

        .text-gold {
            color: var(--gold, #ffd700) !important;
        }

        .text-cyan {
            color: var(--cyan-teal, #1de9b6) !important;
        }

        .rounded-4 {
            border-radius: 1.5rem !important;
        }

        .shadow-lg {
            box-shadow: 0 8px 32px rgba(0,0,0,0.35) !important;
        }

        .product-title {
            color: var(--gold, #ffd700);
            font-size: 2.5rem;
            line-height: 1.2;
        }

        .current-price {
            color: var(--gold, #ffd700);
        }

        .discount-badge {
            font-size: 0.9rem;
            font-weight: bold;
        }

        .detail-section {
            background: #23272f;
        }

        .badge.bg-cyan {
            background: var(--cyan-teal, #1de9b6) !important;
            color: #181c24 !important;
        }

        .badge.bg-pink {
            background: #e91e63 !important;
        }

        .additional-image-container {
            overflow: hidden;
            border-radius: 0.75rem;
            border: 2px solid var(--cyan-teal, #1de9b6);
            transition: transform 0.3s ease;
        }

        .additional-image-container:hover {
            transform: scale(1.05);
        }

        .additional-image {
            width: 100%;
            height: 120px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .attribute-group .badge {
            margin: 2px;
        }

        .main-product-image {
            border: 3px solid var(--cyan-teal, #1de9b6);
            border-radius: 1.5rem;
            overflow: hidden;
            background: #1a1e26;
        }

    </style>
}

@section Scripts {
    <script>
        function confirmDelete(button) {
            const productId = button.getAttribute('data-product-id');
            const productName = button.getAttribute('data-product-name');
            
            document.getElementById('ProductId').value = productId;
            document.getElementById('ProductName').textContent = productName;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
        
        function duplicateProduct(productId) {
            // This would require implementing a duplicate action in the controller
            if (confirm('Do you want to duplicate this product?')) {
                // Redirect to create page with duplicate parameter
                window.location.href = '@Url.Action("Create")?duplicateId=' + productId;
            }
        }
        
        // Image gallery functionality
        document.querySelectorAll('.additional-image').forEach(function(img) {
            img.addEventListener('click', function() {
                const mainImg = document.querySelector('.main-product-image img');
                if (mainImg) {
                    const tempSrc = mainImg.src;
                    mainImg.src = this.src;
                    this.src = tempSrc;
                }
            });
        });
    </script>
}