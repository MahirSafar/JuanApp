using JuanApp.Domain.Common;
using System.ComponentModel.DataAnnotations.Schema;

namespace JuanApp.Domain.Models
{
    public class Size : AuditEntity
    {
        public string Name { get; set; }  // e.g., "S", "M", "L", "XL" for clothes or "7", "8", "9" for shoes
        [Column(TypeName = "decimal(5, 2)")]
        public decimal? ShoeSize { get; set; }  // Made nullable for non-shoe products
        public string Type { get; set; }  // e.g., "Clothing", "Shoe"
        
        // Navigation Properties
        public ICollection<ProductSize> ProductSizes { get; set; } = new List<ProductSize>();
    }
}
