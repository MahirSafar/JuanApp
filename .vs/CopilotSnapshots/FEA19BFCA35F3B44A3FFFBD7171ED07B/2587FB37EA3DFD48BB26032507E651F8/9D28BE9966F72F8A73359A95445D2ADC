using JuanApp.Domain.Models;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace JuanApp.Persistance.DAL.Configurations
{
    public class ProductTagConfig : IEntityTypeConfiguration<ProductTag>
    {
        public void Configure(EntityTypeBuilder<ProductTag> builder)
        {
            // Composite key
            builder.HasKey(pt => new { pt.ProductId, pt.TagId });

            // Relationships
            builder.HasOne(pt => pt.Product)
                .WithMany(p => p.ProductTags)
                .HasForeignKey(pt => pt.ProductId)
                .OnDelete(DeleteBehavior.Cascade);

            builder.HasOne(pt => pt.Tag)
                .WithMany(t => t.ProductTags)
                .HasForeignKey(pt => pt.TagId)
                .OnDelete(DeleteBehavior.Cascade);

            // Seed Data
            builder.HasData(
                // Running Shoes (Product 1) - Tags
                new ProductTag { Id = 1, ProductId = 1, TagId = 1, Created = DateTime.UtcNow },  // New Arrival
                new ProductTag { Id = 2, ProductId = 1, TagId = 4, Created = DateTime.UtcNow },  // Featured
                new ProductTag { Id = 3, ProductId = 1, TagId = 10, Created = DateTime.UtcNow }, // Unisex
                
                // T-Shirt (Product 2) - Tags
                new ProductTag { Id = 4, ProductId = 2, TagId = 2, Created = DateTime.UtcNow },  // Best Seller
                new ProductTag { Id = 5, ProductId = 2, TagId = 3, Created = DateTime.UtcNow },  // Sale
                new ProductTag { Id = 6, ProductId = 2, TagId = 8, Created = DateTime.UtcNow },  // Summer Collection
                new ProductTag { Id = 7, ProductId = 2, TagId = 10, Created = DateTime.UtcNow }, // Unisex
                
                // Handbag (Product 3) - Tags
                new ProductTag { Id = 8, ProductId = 3, TagId = 1, Created = DateTime.UtcNow },  // New Arrival
                new ProductTag { Id = 9, ProductId = 3, TagId = 3, Created = DateTime.UtcNow },  // Sale
                new ProductTag { Id = 10, ProductId = 3, TagId = 5, Created = DateTime.UtcNow }, // Premium
                new ProductTag { Id = 11, ProductId = 3, TagId = 6, Created = DateTime.UtcNow }  // Limited Edition
            );
        }
    }
}