@model ProductViewModel

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="zenith-card-title mb-1 fw-bold text-gold">Edit Product</h2>
            <p class="text-muted mb-0">Update product information and manage images.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-cyan rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" class="row g-4">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Created" />
        <input type="hidden" asp-for="MainImageUrl" />
        
        <!-- Basic Information -->
        <div class="col-12">
            <h4 class="text-gold mb-3"><i class="fas fa-info-circle me-2"></i>Basic Information</h4>
        </div>
        
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control bg-dark text-light border-cyan" placeholder="Product Name" />
                <label asp-for="Name" class="text-gold">Product Name *</label>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <input asp-for="Price" class="form-control bg-dark text-light border-cyan" type="number" step="0.01" placeholder="Price" />
                <label asp-for="Price" class="text-gold">Price ($) *</label>
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <input asp-for="Discount" class="form-control bg-dark text-light border-cyan" type="number" step="0.01" placeholder="Discount" />
                <label asp-for="Discount" class="text-gold">Discount (%)</label>
                <span asp-validation-for="Discount" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select bg-dark text-light border-cyan">
                    <option value="">Select Category</option>
                </select>
                <label asp-for="CategoryId" class="text-gold">Category *</label>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <select asp-for="Gender" asp-items="ViewBag.Genders" class="form-select bg-dark text-light border-cyan">
                    <option value="">Select Gender</option>
                </select>
                <label asp-for="Gender" class="text-gold">Gender *</label>
                <span asp-validation-for="Gender" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <input asp-for="Stock" class="form-control bg-dark text-light border-cyan" type="number" placeholder="Stock" />
                <label asp-for="Stock" class="text-gold">Stock Quantity *</label>
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-12">
            <label asp-for="Description" class="form-label text-gold fw-semibold">Description *</label>
            <textarea asp-for="Description" class="form-control bg-dark text-light border-cyan" rows="4" placeholder="Product description..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <!-- Main Image Management -->
        <div class="col-12">
            <h4 class="text-gold mb-3 mt-4"><i class="fas fa-image me-2"></i>Main Product Image</h4>
        </div>
        
        <div class="col-12">
            <div class="image-upload-section p-4 rounded-4 bg-dark border border-cyan mb-4">
                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                {
                    <div class="current-image mb-3">
                        <p class="small text-muted mb-2">Current Main Image:</p>
                        <div class="d-flex align-items-start gap-3">
                            <img src="~/uploads/products/@Model.MainImageUrl" alt="Current image" class="current-image-preview rounded-3" />
                            <div>
                                <p class="small text-light mb-2">@Model.MainImageUrl</p>
                                <div class="form-check">
                                    <input asp-for="RemoveMainImage" class="form-check-input" type="checkbox" id="removeMainImage" />
                                    <label class="form-check-label text-warning" for="removeMainImage">
                                        <i class="fas fa-trash me-1"></i>Remove current main image (requires new image upload)
                                    </label>
                                    <div class="form-text text-muted small">
                                        Note: You must upload a replacement image when removing the current one.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="border-secondary" />
                }
                
                <div class="custom-file-upload">
                    <input asp-for="MainImageFile" class="file-input" type="file" accept="image/*" id="mainImageFile" />
                    <label for="mainImageFile" class="file-label btn btn-outline-cyan">
                        <i class="fas fa-cloud-upload-alt me-2"></i>
                        @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                        {
                            <text>Replace Main Image</text>
                        }
                        else
                        {
                            <text>Choose Main Image *</text>
                        }
                    </label>
                    <span class="file-name text-muted small ms-3">No file chosen</span>
                </div>
                
                <span asp-validation-for="MainImageFile" class="text-danger small d-block mt-2"></span>
                
                <div class="form-text text-muted small mt-2">
                    <i class="fas fa-info-circle me-1"></i>
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <text>Optional replacement image. Maximum file size: 5MB. Supported formats: JPG, PNG, GIF, WebP</text>
                    }
                    else
                    {
                        <text><strong>Required.</strong> Maximum file size: 5MB. Supported formats: JPG, PNG, GIF, WebP</text>
                    }
                </div>
                
                <div class="image-preview mt-3" id="mainImagePreview" style="display: none;">
                    <p class="small text-muted mb-2">New Main Image Preview:</p>
                    <img id="mainPreviewImg" class="preview-image rounded-3" alt="Preview" />
                </div>
            </div>
        </div>

        <!-- Additional Images Management -->
        <div class="col-12">
            <h4 class="text-gold mb-3"><i class="fas fa-images me-2"></i>Additional Images</h4>
        </div>
        
        <div class="col-12">
            <div class="image-upload-section p-4 rounded-4 bg-dark border border-cyan mb-4">
                @if (Model.ProductImages.Any())
                {
                    <div class="current-additional-images mb-3">
                        <p class="small text-muted mb-2">Current Additional Images:</p>
                        <div class="row g-3">
                            @foreach (var image in Model.ProductImages)
                            {
                                <div class="col-md-3 col-sm-4 col-6">
                                    <div class="current-additional-image">
                                        <img src="~/uploads/products/@image.ImageUrl" alt="Additional image" class="img-fluid rounded-3 current-additional-preview" />
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" name="RemoveImageIds" value="@image.Id" id="removeImage@(image.Id)" />
                                            <label class="form-check-label text-warning small" for="removeImage@(image.Id)">
                                                <i class="fas fa-trash me-1"></i>Remove
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <hr class="border-secondary" />
                }
                
                <div class="custom-file-upload">
                    <input asp-for="AdditionalImageFiles" class="file-input" type="file" accept="image/*" id="additionalImageFiles" multiple />
                    <label for="additionalImageFiles" class="file-label btn btn-outline-secondary">
                        <i class="fas fa-plus me-2"></i>Add More Images
                    </label>
                    <span class="additional-file-names text-muted small ms-3">No files chosen</span>
                </div>
                
                <span asp-validation-for="AdditionalImageFiles" class="text-danger small d-block mt-2"></span>
                
                <div class="form-text text-muted small mt-2">
                    <i class="fas fa-info-circle me-1"></i>
                    Optional. Maximum 5 additional images. Each file max 5MB.
                </div>
                
                <div class="additional-images-preview mt-3" id="additionalImagesPreview"></div>
            </div>
        </div>

        <!-- Attributes Section -->
        <div class="col-12">
            <h4 class="text-gold mb-3 mt-4"><i class="fas fa-tags me-2"></i>Product Attributes</h4>
        </div>
        
        <div class="col-md-4">
            <label class="form-label text-gold fw-semibold">Colors *</label>
            <div class="attribute-selection p-3 rounded bg-dark border border-secondary">
                @foreach (var color in ViewBag.Colors)
                {
                    <div class="form-check">
                        <input class="form-check-input color-checkbox" type="checkbox" name="SelectedColorIds" value="@color.Id" id="color@(color.Id)" 
                               @(Model.SelectedColorIds.Contains(color.Id) ? "checked" : "") />
                        <label class="form-check-label text-light" for="color@(color.Id)">
                            @color.Name
                        </label>
                    </div>
                }
            </div>
            <span asp-validation-for="SelectedColorIds" class="text-danger small d-block mt-1"></span>
            <div class="validation-message text-danger small mt-1" id="colorValidation" style="display: none;">
                At least one color must be selected.
            </div>
        </div>
        
        <div class="col-md-4">
            <label class="form-label text-gold fw-semibold">Sizes *</label>
            <div class="attribute-selection p-3 rounded bg-dark border border-secondary">
                @foreach (var size in ViewBag.Sizes)
                {
                    <div class="form-check">
                        <input class="form-check-input size-checkbox" type="checkbox" name="SelectedSizeIds" value="@size.Id" id="size@(size.Id)" 
                               @(Model.SelectedSizeIds.Contains(size.Id) ? "checked" : "") />
                        <label class="form-check-label text-light" for="size@(size.Id)">
                            @size.Name
                        </label>
                    </div>
                }
            </div>
            <span asp-validation-for="SelectedSizeIds" class="text-danger small d-block mt-1"></span>
            <div class="validation-message text-danger small mt-1" id="sizeValidation" style="display: none;">
                At least one size must be selected.
            </div>
        </div>
        
        <div class="col-md-4">
            <label class="form-label text-gold fw-semibold">Tags</label>
            <div class="attribute-selection p-3 rounded bg-dark border border-secondary">
                @foreach (var tag in ViewBag.Tags)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedTagIds" value="@tag.Id" id="tag@(tag.Id)" 
                               @(Model.SelectedTagIds.Contains(tag.Id) ? "checked" : "") />
                        <label class="form-check-label text-light" for="tag@(tag.Id)">
                            @tag.Name
                        </label>
                    </div>
                }
            </div>
            <div class="form-text text-muted small mt-1">
                Optional. Select relevant tags for better searchability.
            </div>
        </div>
        
        <div class="col-12">
            <div class="alert alert-warning border-warning bg-dark text-light mt-4">
                <h6 class="text-warning mb-2"><i class="fas fa-clock me-2"></i>Product Information:</h6>
                <div class="small">
                    <p class="mb-1"><strong>Created:</strong> @Model.Created.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                    @if (Model.LastModified.HasValue)
                    {
                        <p class="mb-0"><strong>Last Modified:</strong> @Model.LastModified.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-12">
            <button type="submit" class="btn btn-cyan px-4 rounded-pill fw-semibold shadow-sm">
                <i class="fas fa-save me-2"></i>Update Product
            </button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .zenith-card {
            background: var(--card-bg, #181c24);
            border-radius: 1.5rem;
            box-shadow: 0 4px 32px rgba(0,0,0,0.25);
        }

        .zenith-card-title {
            color: var(--gold, #ffd700);
        }

        .btn-cyan, .btn-outline-cyan {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
            border: none;
        }

        .btn-outline-cyan {
            background: transparent;
            border: 2px solid var(--cyan-teal, #1de9b6);
            color: var(--cyan-teal, #1de9b6);
        }

        .border-cyan {
            border-color: var(--cyan-teal, #1de9b6) !important;
        }

        .text-gold {
            color: var(--gold, #ffd700) !important;
        }

        .form-floating > label {
            color: var(--gold, #ffd700);
        }

        .form-control, .form-select {
            background: #23272f;
            color: #fff;
            border-radius: 0.75rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--cyan-teal, #1de9b6);
            box-shadow: 0 0 0 0.2rem rgba(29,233,182,0.15);
        }

        .image-upload-section {
            background: #23272f;
        }

        .custom-file-upload {
            display: flex;
            align-items: center;
        }

        .file-input {
            display: none;
        }

        .file-label {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .preview-image, .current-image-preview {
            max-width: 200px;
            max-height: 150px;
            object-fit: cover;
            border: 2px solid var(--cyan-teal, #1de9b6);
        }

        .current-image-preview {
            width: 150px;
            height: 100px;
        }

        .current-additional-preview {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border: 2px solid var(--cyan-teal, #1de9b6);
        }

        .additional-preview-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border: 2px solid var(--cyan-teal, #1de9b6);
            margin: 5px;
        }

        .attribute-selection {
            max-height: 200px;
            overflow-y: auto;
        }

        .form-check-input:checked {
            background-color: var(--cyan-teal, #1de9b6);
            border-color: var(--cyan-teal, #1de9b6);
        }

        .current-additional-image {
            position: relative;
        }
    </style>
}

@section Scripts {
    <script>
        // Function to validate color and size selection
        function validateColorAndSizeSelection() {
            const colorCheckboxes = document.querySelectorAll('.color-checkbox:checked');
            const sizeCheckboxes = document.querySelectorAll('.size-checkbox:checked');
            const colorValidation = document.getElementById('colorValidation');
            const sizeValidation = document.getElementById('sizeValidation');
            
            let isValid = true;
            
            // Validate colors
            if (colorCheckboxes.length === 0) {
                colorValidation.style.display = 'block';
                isValid = false;
            } else {
                colorValidation.style.display = 'none';
            }
            
            // Validate sizes
            if (sizeCheckboxes.length === 0) {
                sizeValidation.style.display = 'block';
                isValid = false;
            } else {
                sizeValidation.style.display = 'none';
            }
            
            return isValid;
        }
        
        // Add event listeners to checkboxes for real-time validation
        document.querySelectorAll('.color-checkbox').forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                validateColorAndSizeSelection();
            });
        });
        
        document.querySelectorAll('.size-checkbox').forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                validateColorAndSizeSelection();
            });
        });
        
        // Function to save hidden images to sessionStorage
        function saveHiddenImages() {
            const hiddenImages = [];
            document.querySelectorAll('input[name="RemoveImageIds"]:checked').forEach(function(checkbox) {
                hiddenImages.push(checkbox.value);
            });
            sessionStorage.setItem('hiddenProductImages', JSON.stringify(hiddenImages));
        }
        
        // Function to restore hidden images from sessionStorage
        function restoreHiddenImages() {
            const hiddenImages = JSON.parse(sessionStorage.getItem('hiddenProductImages') || '[]');
            hiddenImages.forEach(function(imageId) {
                const checkbox = document.getElementById('removeImage' + imageId);
                if (checkbox) {
                    checkbox.checked = true;
                    const imageContainer = checkbox.closest('.current-additional-image');
                    if (imageContainer) {
                        imageContainer.style.display = 'none';
                    }
                }
            });
        }
        
        // Main image preview
        document.getElementById('mainImageFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const fileName = document.querySelector('.file-name');
            const preview = document.getElementById('mainImagePreview');
            const previewImg = document.getElementById('mainPreviewImg');
            
            if (file) {
                fileName.textContent = file.name;
                fileName.classList.remove('text-muted');
                fileName.classList.add('text-cyan');
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                fileName.textContent = 'No file chosen';
                fileName.classList.remove('text-cyan');
                fileName.classList.add('text-muted');
                preview.style.display = 'none';
            }
        });
        
        // Additional images preview
        document.getElementById('additionalImageFiles').addEventListener('change', function(e) {
            const files = e.target.files;
            const fileNames = document.querySelector('.additional-file-names');
            const previewContainer = document.getElementById('additionalImagesPreview');
            
            if (files && files.length > 0) {
                fileNames.textContent = `${files.length} file(s) selected`;
                fileNames.classList.remove('text-muted');
                fileNames.classList.add('text-cyan');
                
                previewContainer.innerHTML = '';
                
                Array.from(files).slice(0, 5).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'additional-preview-image rounded-3';
                        img.alt = 'Additional preview';
                        previewContainer.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                fileNames.textContent = 'No files chosen';
                fileNames.classList.remove('text-cyan');
                fileNames.classList.add('text-muted');
                previewContainer.innerHTML = '';
            }
        });
        
        // Handle remove main image checkbox
        document.getElementById('removeMainImage')?.addEventListener('change', function(e) {
            const currentImage = document.querySelector('.current-image');
            const imageFile = document.getElementById('mainImageFile');
            
            if (e.target.checked) {
                currentImage.style.opacity = '0.5';
                imageFile.setAttribute('required', 'required');
            } else {
                currentImage.style.opacity = '1';
                imageFile.removeAttribute('required');
            }
        });
        
        // Handle remove additional image checkboxes
        document.querySelectorAll('input[name="RemoveImageIds"]').forEach(function(checkbox) {
            checkbox.addEventListener('change', function(e) {
                const imageContainer = e.target.closest('.current-additional-image');
                if (e.target.checked) {
                    imageContainer.style.display = 'none';
                } else {
                    imageContainer.style.display = 'block';
                }
                // Save state to sessionStorage
                saveHiddenImages();
            });
        });
        
        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const removeMainImage = document.getElementById('removeMainImage');
            const mainImageFile = document.getElementById('mainImageFile');
            const hasCurrentMainImage = @(string.IsNullOrEmpty(Model.MainImageUrl) ? "false" : "true");
            
            // If removing main image, must provide replacement
            if (removeMainImage && removeMainImage.checked && (!mainImageFile.files || mainImageFile.files.length === 0)) {
                e.preventDefault();
                alert('When removing the current main image, you must upload a replacement image.');
                mainImageFile.focus();
                return false;
            }
            
            // If no current main image, must provide one
            if (!hasCurrentMainImage && (!mainImageFile.files || mainImageFile.files.length === 0)) {
                e.preventDefault();
                alert('Please select a main product image.');
                mainImageFile.focus();
                return false;
            }
            
            // Validate color and size selection
            if (!validateColorAndSizeSelection()) {
                e.preventDefault();
                alert('Please select at least one color and one size for the product.');
                return false;
            }
            
            // Clear sessionStorage on successful form submission
            sessionStorage.removeItem('hiddenProductImages');
        });
        
        // Initialize: restore hidden images on page load and validate selection
        document.addEventListener('DOMContentLoaded', function() {
            restoreHiddenImages();
            validateColorAndSizeSelection();
        });
        
        // Clear sessionStorage when leaving the page (not via form submission)
        window.addEventListener('beforeunload', function(e) {
            // Only clear if we're not submitting the form
            if (!document.querySelector('form').reportValidity || !document.querySelector('form').checkValidity()) {
                sessionStorage.removeItem('hiddenProductImages');
            }
        });
    </script>
}