@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zenith Admin Panel</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Fira+Code:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/admin/css/zenith-admin.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="zenith-theme">
    <div class="zenith-admin-container sidebar-collapsed">
        <!-- Sidebar -->
        <aside class="zenith-sidebar" id="sidebar">
            <div class="zenith-sidebar-header">
                <div class="zenith-logo">
                    <span class="zenith-logo-icon"><i class="fas fa-gem"></i></span>
                    <span class="zenith-logo-text">ZENITH</span>
                </div>
            </div>
            <nav class="zenith-nav">
                <a asp-controller="dashboard" asp-action="index"  class="zenith-nav-item"><i class="fas fa-chart-line"></i><span>Dashboard</span></a>
                <a asp-controller="newsletter" asp-action="send" class="zenith-nav-item"><i class="fa-solid fa-envelope"></i><span>Newsletter</span></a>
                <a asp-controller="slider" asp-action="index" class="zenith-nav-item"><i class="fa-brands fa-slideshare"></i><span>Slider</span></a>
                <a asp-controller="service" asp-action="index" class="zenith-nav-item"><i class="fa-brands fa-servicestack"></i><span>Services</span></a>
                <a asp-controller="category" asp-action="index" class="zenith-nav-item"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a>
                <a asp-controller="tag" asp-action="index" class="zenith-nav-item"><i class="fa-solid fa-tags"></i><span>Tags</span></a>
                <a asp-controller="color" asp-action="index" class="zenith-nav-item"><i class="fa-solid fa-palette"></i><span>Colors</span></a>
                <a asp-controller="size" asp-action="index" class="zenith-nav-item"><i class="fa-solid fa-expand-arrows-alt"></i><span>Sizes</span></a>
                <a asp-controller="setting" asp-action="index" class="zenith-nav-item"><i class="fas fa-cogs"></i><span>Settings</span></a>
                <a href="/manage/security" class="zenith-nav-item"><i class="fas fa-shield-alt"></i><span>Security</span></a>
            </nav>
            <div class="zenith-sidebar-footer">
                <div class="zenith-user-info">
                    <div class="zenith-user-avatar"><i class="fas fa-user"></i></div>
                    <div class="zenith-user-details">
                        <span class="zenith-user-name">Admin User</span>
                        <span class="zenith-user-role">System Admin</span>
                    </div>
                </div>
            </div>
        </aside>
        <!-- Main Content -->
        <main class="zenith-main">
            <header class="zenith-header">
                <div class="zenith-header-left">
                    <button class="menu-toggle" id="hamburger" aria-label="Toggle sidebar">
                        <span class="bar"></span>
                        <span class="bar"></span>
                        <span class="bar"></span>
                    </button>
                    <div class="zenith-header-title">Dashboard</div>
                </div>
                <div class="zenith-header-actions">
                    <a asp-area="manage" asp-controller="account" asp-action="logout" class="zenith-action-btn"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
                </div>
            </header>
            <section class="zenith-content">
                @RenderBody()
            </section>
        </main>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/admin/js/zenith-admin.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>