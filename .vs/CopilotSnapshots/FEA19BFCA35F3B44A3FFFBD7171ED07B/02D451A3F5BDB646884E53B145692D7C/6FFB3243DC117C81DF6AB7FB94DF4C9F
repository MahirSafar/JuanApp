@model SettingViewModel
@{
    ViewData["Title"] = "Setting Details";
}

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="zenith-card-title mb-1 fw-bold text-gold">Setting Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-cyan rounded-pill px-4 me-2">
                <i class="fas fa-edit me-2"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-md-8">
            <div class="detail-section p-4 rounded-4 bg-dark border border-cyan">
                <h3 class="detail-title mb-4 text-gold fw-bold">
                    <i class="fas fa-cog me-2"></i><code class="text-warning">@Model.Key</code>
                </h3>
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <span class="detail-label">Setting Key</span>
                        <p class="detail-value">
                            <code class="text-warning">@Model.Key</code>
                        </p>
                    </div>
                    
                    <div class="col-md-6">
                        <span class="detail-label">Setting ID</span>
                        <p class="detail-value text-muted">#@Model.Id</p>
                    </div>
                    
                    <div class="col-12">
                        <span class="detail-label">Setting Value</span>
                        <div class="detail-value-container p-3 rounded bg-dark border">
                            @if (!string.IsNullOrEmpty(Model.Value))
                            {
                                <pre class="mb-0 text-light"><code>@Model.Value</code></pre>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No value set</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="detail-section p-4 rounded-4 bg-dark border border-cyan mb-4">
                <h4 class="text-gold mb-3">Setting Information</h4>
                <div class="text-muted small">
                    <p><i class="fas fa-key me-2"></i> <strong>Key:</strong> @Model.Key</p>
                    <p><i class="fas fa-hashtag me-2"></i> <strong>ID:</strong> #@Model.Id</p>
                    <p><i class="fas fa-clock me-2"></i> <strong>Type:</strong> Configuration Setting</p>
                    <p><i class="fas fa-info-circle me-2"></i> Used for application configuration</p>
                </div>
            </div>
            
            <div class="detail-section p-4 rounded-4 bg-dark border border-warning">
                <h5 class="text-warning small mb-2">Usage Guidelines</h5>
                <div class="text-muted small">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1"><i class="fas fa-check text-success me-2"></i>Use descriptive keys</li>
                        <li class="mb-1"><i class="fas fa-check text-success me-2"></i>Follow naming conventions</li>
                        <li class="mb-1"><i class="fas fa-exclamation-triangle text-warning me-2"></i>Be careful with system settings</li>
                        <li><i class="fas fa-times text-danger me-2"></i>Avoid sensitive data in values</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .zenith-card {
            background: var(--card-bg, #181c24);
            border-radius: 1.5rem;
            box-shadow: 0 4px 32px rgba(0,0,0,0.25);
        }

        .zenith-card-title {
            color: var(--gold, #ffd700);
        }

        .btn-cyan, .btn-outline-cyan {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
            border: none;
        }

        .btn-outline-cyan {
            background: transparent;
            border: 2px solid var(--cyan-teal, #1de9b6);
            color: var(--cyan-teal, #1de9b6);
        }

            .btn-outline-cyan:hover, .btn-cyan:hover {
                background: #13bfa6;
                color: #fff;
            }

        .border-cyan {
            border-color: var(--cyan-teal, #1de9b6) !important;
        }

        .text-gold {
            color: var(--gold, #ffd700) !important;
        }

        .text-cyan {
            color: var(--cyan-teal, #1de9b6) !important;
        }

        .rounded-4 {
            border-radius: 1.5rem !important;
        }

        .shadow-lg {
            box-shadow: 0 8px 32px rgba(0,0,0,0.35) !important;
        }

        .detail-title {
            color: var(--gold, #ffd700);
            font-size: 1.5rem;
            font-weight: 600;
        }

        .detail-label {
            color: var(--cyan-teal, #1de9b6);
            font-size: 0.95rem;
            font-weight: 500;
            margin-bottom: 0.25rem;
            display: block;
        }

        .detail-value {
            color: var(--text-main, #fff);
            font-size: 1.1rem;
            margin-bottom: 1rem;
        }

        .detail-section {
            background: #23272f;
        }

        .detail-value-container {
            background: #1a1e26 !important;
            border-color: #404040 !important;
        }

        code {
            background: rgba(255, 193, 7, 0.1);
            color: #ffc107;
            padding: 0.2rem 0.4rem;
            border-radius: 0.25rem;
            font-size: 0.875em;
        }

        pre code {
            background: none;
            padding: 0;
            color: #e9ecef;
        }

        .border-warning {
            border-color: #ffc107 !important;
        }
    </style>
}