@model ProductViewModel

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="zenith-card-title mb-1 fw-bold text-gold">Create Product</h2>
            <p class="text-muted mb-0">Add a new product with images and specifications.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-cyan rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" class="row g-4">
        <!-- Basic Information -->
        <div class="col-12">
            <h4 class="text-gold mb-3"><i class="fas fa-info-circle me-2"></i>Basic Information</h4>
        </div>
        
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control bg-dark text-light border-cyan" placeholder="Product Name" />
                <label asp-for="Name" class="text-gold">Product Name *</label>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <input asp-for="Price" class="form-control bg-dark text-light border-cyan" type="number" step="0.01" placeholder="Price" />
                <label asp-for="Price" class="text-gold">Price ($) *</label>
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <input asp-for="Discount" class="form-control bg-dark text-light border-cyan" type="number" step="0.01" placeholder="Discount" />
                <label asp-for="Discount" class="text-gold">Discount (%)</label>
                <span asp-validation-for="Discount" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select bg-dark text-light border-cyan">
                    <option value="">Select Category</option>
                </select>
                <label asp-for="CategoryId" class="text-gold">Category *</label>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <select asp-for="Gender" asp-items="ViewBag.Genders" class="form-select bg-dark text-light border-cyan">
                    <option value="">Select Gender</option>
                </select>
                <label asp-for="Gender" class="text-gold">Gender *</label>
                <span asp-validation-for="Gender" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="form-floating mb-3">
                <input asp-for="Stock" class="form-control bg-dark text-light border-cyan" type="number" placeholder="Stock" />
                <label asp-for="Stock" class="text-gold">Stock Quantity *</label>
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-12">
            <label asp-for="Description" class="form-label text-gold fw-semibold">Description *</label>
            <textarea asp-for="Description" class="form-control bg-dark text-light border-cyan" rows="4" placeholder="Product description..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <!-- Images Section -->
        <div class="col-12">
            <h4 class="text-gold mb-3 mt-4"><i class="fas fa-images me-2"></i>Product Images</h4>
        </div>
        
        <div class="col-12">
            <div class="image-upload-section p-4 rounded-4 bg-dark border border-cyan mb-4">
                <h5 class="text-gold mb-3">
                    <i class="fas fa-image me-2"></i>Main Product Image *
                </h5>
                
                <div class="custom-file-upload">
                    <input asp-for="MainImageFile" class="file-input" type="file" accept="image/*" id="mainImageFile" required />
                    <label for="mainImageFile" class="file-label btn btn-outline-cyan">
                        <i class="fas fa-cloud-upload-alt me-2"></i>Choose Main Image *
                    </label>
                    <span class="file-name text-muted small ms-3">No file chosen</span>
                </div>
                
                <span asp-validation-for="MainImageFile" class="text-danger small d-block mt-2"></span>
                
                <div class="form-text text-danger small mt-2">
                    <i class="fas fa-exclamation-circle me-1"></i>
                    <strong>Required.</strong> Maximum file size: 5MB. Supported formats: JPG, PNG, GIF, WebP
                </div>
                
                <div class="image-preview mt-3" id="mainImagePreview" style="display: none;">
                    <img id="mainPreviewImg" class="preview-image rounded-3" alt="Preview" />
                </div>
            </div>
        </div>
        
        <div class="col-12">
            <div class="image-upload-section p-4 rounded-4 bg-dark border border-cyan mb-4">
                <h5 class="text-gold mb-3">
                    <i class="fas fa-images me-2"></i>Additional Images
                </h5>
                
                <div class="custom-file-upload">
                    <input asp-for="AdditionalImageFiles" class="file-input" type="file" accept="image/*" id="additionalImageFiles" multiple />
                    <label for="additionalImageFiles" class="file-label btn btn-outline-secondary">
                        <i class="fas fa-plus me-2"></i>Add More Images
                    </label>
                    <span class="additional-file-names text-muted small ms-3">No files chosen</span>
                </div>
                
                <span asp-validation-for="AdditionalImageFiles" class="text-danger small d-block mt-2"></span>
                
                <div class="form-text text-muted small mt-2">
                    <i class="fas fa-info-circle me-1"></i>
                    Optional. Maximum 5 additional images. Each file max 5MB.
                </div>
                
                <div class="additional-images-preview mt-3" id="additionalImagesPreview"></div>
            </div>
        </div>

        <!-- Attributes Section -->
        <div class="col-12">
            <h4 class="text-gold mb-3 mt-4"><i class="fas fa-tags me-2"></i>Product Attributes</h4>
        </div>
        
        <div class="col-md-4">
            <label class="form-label text-gold fw-semibold">Colors *</label>
            <div class="attribute-selection p-3 rounded bg-dark border border-secondary">
                @foreach (var color in ViewBag.Colors)
                {
                    <div class="form-check">
                        <input class="form-check-input color-checkbox" type="checkbox" name="SelectedColorIds" value="@color.Id" id="color@(color.Id)" />
                        <label class="form-check-label text-light" for="color@(color.Id)">
                            @color.Name
                        </label>
                    </div>
                }
            </div>
            <span asp-validation-for="SelectedColorIds" class="text-danger small d-block mt-1"></span>
            <div class="validation-message text-danger small mt-1" id="colorValidation" style="display: none;">
                At least one color must be selected.
            </div>
        </div>
        
        <div class="col-md-4">
            <label class="form-label text-gold fw-semibold">Sizes *</label>
            <div class="attribute-selection p-3 rounded bg-dark border border-secondary">
                @foreach (var size in ViewBag.Sizes)
                {
                    <div class="form-check">
                        <input class="form-check-input size-checkbox" type="checkbox" name="SelectedSizeIds" value="@size.Id" id="size@(size.Id)" />
                        <label class="form-check-label text-light" for="size@(size.Id)">
                            @size.Name
                        </label>
                    </div>
                }
            </div>
            <span asp-validation-for="SelectedSizeIds" class="text-danger small d-block mt-1"></span>
            <div class="validation-message text-danger small mt-1" id="sizeValidation" style="display: none;">
                At least one size must be selected.
            </div>
        </div>
        
        <div class="col-md-4">
            <label class="form-label text-gold fw-semibold">Tags</label>
            <div class="attribute-selection p-3 rounded bg-dark border border-secondary">
                @foreach (var tag in ViewBag.Tags)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedTagIds" value="@tag.Id" id="tag@(tag.Id)" />
                        <label class="form-check-label text-light" for="tag@(tag.Id)">
                            @tag.Name
                        </label>
                    </div>
                }
            </div>
            <div class="form-text text-muted small mt-1">
                Optional. Select relevant tags for better searchability.
            </div>
        </div>
        
        <div class="col-12">
            <div class="alert alert-info border-cyan bg-dark text-light mt-4">
                <h6 class="text-cyan mb-2"><i class="fas fa-lightbulb me-2"></i>Product Tips:</h6>
                <div class="small">
                    <ul class="mb-0">
                        <li>Use high-quality images for better customer experience</li>
                        <li>Write detailed descriptions with key features</li>
                        <li>Select appropriate colors, sizes, and tags for better searchability</li>
                        <li>Set competitive pricing with appropriate discounts</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-12">
            <button type="submit" class="btn btn-cyan px-4 rounded-pill fw-semibold shadow-sm">
                <i class="fas fa-save me-2"></i>Create Product
            </button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .zenith-card {
            background: var(--card-bg, #181c24);
            border-radius: 1.5rem;
            box-shadow: 0 4px 32px rgba(0,0,0,0.25);
        }

        .zenith-card-title {
            color: var(--gold, #ffd700);
        }

        .btn-cyan, .btn-outline-cyan {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
            border: none;
        }

        .btn-outline-cyan {
            background: transparent;
            border: 2px solid var(--cyan-teal, #1de9b6);
            color: var(--cyan-teal, #1de9b6);
        }

        .border-cyan {
            border-color: var(--cyan-teal, #1de9b6) !important;
        }

        .text-gold {
            color: var(--gold, #ffd700) !important;
        }

        .form-floating > label {
            color: var(--gold, #ffd700);
        }

        .form-control, .form-select {
            background: #23272f;
            color: #fff;
            border-radius: 0.75rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--cyan-teal, #1de9b6);
            box-shadow: 0 0 0 0.2rem rgba(29,233,182,0.15);
        }

        .image-upload-section {
            background: #23272f;
        }

        .custom-file-upload {
            display: flex;
            align-items: center;
        }

        .file-input {
            display: none;
        }

        .file-label {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .preview-image {
            max-width: 200px;
            max-height: 150px;
            object-fit: cover;
            border: 2px solid var(--cyan-teal, #1de9b6);
        }

        .additional-preview-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border: 2px solid var(--cyan-teal, #1de9b6);
            margin: 5px;
        }

        .attribute-selection {
            max-height: 200px;
            overflow-y: auto;
        }

        .form-check-input:checked {
            background-color: var(--cyan-teal, #1de9b6);
            border-color: var(--cyan-teal, #1de9b6);
        }
    </style>
}

@section Scripts {
    <script>
        // Function to validate color and size selection
        function validateColorAndSizeSelection() {
            const colorCheckboxes = document.querySelectorAll('.color-checkbox:checked');
            const sizeCheckboxes = document.querySelectorAll('.size-checkbox:checked');
            const colorValidation = document.getElementById('colorValidation');
            const sizeValidation = document.getElementById('sizeValidation');
            
            let isValid = true;
            
            // Validate colors
            if (colorCheckboxes.length === 0) {
                colorValidation.style.display = 'block';
                isValid = false;
            } else {
                colorValidation.style.display = 'none';
            }
            
            // Validate sizes
            if (sizeCheckboxes.length === 0) {
                sizeValidation.style.display = 'block';
                isValid = false;
            } else {
                sizeValidation.style.display = 'none';
            }
            
            return isValid;
        }
        
        // Add event listeners to checkboxes for real-time validation
        document.querySelectorAll('.color-checkbox').forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                validateColorAndSizeSelection();
            });
        });
        
        document.querySelectorAll('.size-checkbox').forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                validateColorAndSizeSelection();
            });
        });
        
        // Main image preview
        document.getElementById('mainImageFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const fileName = document.querySelector('.file-name');
            const preview = document.getElementById('mainImagePreview');
            const previewImg = document.getElementById('mainPreviewImg');
            
            if (file) {
                fileName.textContent = file.name;
                fileName.classList.remove('text-muted');
                fileName.classList.add('text-cyan');
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                fileName.textContent = 'No file chosen';
                fileName.classList.remove('text-cyan');
                fileName.classList.add('text-muted');
                preview.style.display = 'none';
            }
        });
        
        // Additional images preview
        document.getElementById('additionalImageFiles').addEventListener('change', function(e) {
            const files = e.target.files;
            const fileNames = document.querySelector('.additional-file-names');
            const previewContainer = document.getElementById('additionalImagesPreview');
            
            if (files && files.length > 0) {
                fileNames.textContent = `${files.length} file(s) selected`;
                fileNames.classList.remove('text-muted');
                fileNames.classList.add('text-cyan');
                
                previewContainer.innerHTML = '';
                
                Array.from(files).slice(0, 5).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'additional-preview-image rounded-3';
                        img.alt = 'Additional preview';
                        previewContainer.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                fileNames.textContent = 'No files chosen';
                fileNames.classList.remove('text-cyan');
                fileNames.classList.add('text-muted');
                previewContainer.innerHTML = '';
            }
        });
        
        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const mainImageFile = document.getElementById('mainImageFile');
            
            // Validate main image
            if (!mainImageFile.files || mainImageFile.files.length === 0) {
                e.preventDefault();
                alert('Please select a main product image.');
                mainImageFile.focus();
                return false;
            }
            
            // Validate color and size selection
            if (!validateColorAndSizeSelection()) {
                e.preventDefault();
                alert('Please select at least one color and one size for the product.');
                return false;
            }
        });
    </script>
}