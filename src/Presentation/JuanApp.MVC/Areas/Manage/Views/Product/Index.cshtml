@model PaginatedList<ProductViewModel>
@{
    ViewData["Title"] = "Products";
}

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="zenith-card-title mb-1 fw-bold text-gold">Products</h2>
            <p class="text-muted mb-0">Manage product catalog and inventory</p>
        </div>
        <a asp-action="Create" class="btn btn-cyan px-4 py-2 rounded-pill fw-semibold shadow-sm">
            <i class="fas fa-plus-circle me-2"></i>New Product
        </a>
    </div>

    <!-- Filters -->
    <div class="filter-section p-3 rounded-4 bg-dark border border-cyan mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <select class="form-select bg-dark text-light border-cyan" onchange="filterByCategory(this.value)">
                    <option value="">All Categories</option>
                    @foreach (var category in ViewBag.FilterCategories as SelectList)
                    {
                        <option value="@category.Value">@category.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select class="form-select bg-dark text-light border-cyan" onchange="filterByGender(this.value)">
                    @foreach (var gender in ViewBag.FilterGenders as SelectList)
                    {
                        <option value="@gender.Value">@gender.Text</option>
                    }
                </select>
            </div>
           
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-lg-6 col-xl-3">
                <div class="product-card h-100 bg-dark rounded-4 border border-cyan shadow-sm overflow-hidden">
                    @if (!string.IsNullOrEmpty(item.MainImageUrl))
                    {
                        <div class="product-image-container">
                            <img src="~/uploads/products/@item.MainImageUrl" alt="@item.Name" class="product-image" 
                                 onerror="this.style.display='none'; this.parentNode.innerHTML='<div class=&quot;product-image-placeholder&quot;><i class=&quot;fas fa-box fa-3x text-muted&quot;></i></div>';" />
                            @if (item.Discount > 0)
                            {
                                <span class="discount-badge">-@item.Discount%</span>
                            }
                            @if (item.Stock <= 0)
                            {
                                <span class="stock-badge">Out of Stock</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="product-image-placeholder">
                            <i class="fas fa-box fa-3x text-muted"></i>
                        </div>
                    }
                    
                    <div class="product-content p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-cyan small">@item.CategoryName</span>
                            <span class="badge @(item.Gender == "Men" ? "bg-primary" : item.Gender == "Women" ? "bg-pink" : "bg-success") small">@item.Gender</span>
                        </div>
                        
                        <h5 class="product-title text-gold fw-bold mb-2">
                            @if (item.Name.Length > 30)
                            {
                                @(item.Name.Substring(0, 30) + "...")
                            }
                            else
                            {
                                @item.Name
                            }
                        </h5>
                        
                        <p class="product-description text-muted small mb-3">
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                if (item.Description.Length > 80)
                                {
                                    @(item.Description.Substring(0, 80) + "...")
                                }
                                else
                                {
                                    @item.Description
                                }
                            }
                        </p>
                        
                        <div class="product-price mb-3">
                            @if (item.Discount > 0)
                            {
                                var discountedPrice = item.Price - (item.Price * item.Discount / 100);
                                <span class="current-price text-gold fw-bold">$@discountedPrice.ToString("F2")</span>
                                <span class="original-price text-muted text-decoration-line-through small">$@item.Price.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="current-price text-gold fw-bold">$@item.Price.ToString("F2")</span>
                            }
                        </div>
                        
                        <div class="product-info mb-3">
                            <small class="text-muted">
                                <i class="fas fa-boxes me-1"></i>Stock: @item.Stock
                                @if (item.ProductImages.Any())
                                {
                                    <span class="ms-2"><i class="fas fa-images me-1"></i>@(item.ProductImages.Count + 1) images</span>
                                }
                            </small>
                        </div>
                        
                        <div class="product-actions d-flex gap-2">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3 flex-fill" title="View">
                                <i class="fas fa-eye me-1"></i>View
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-cyan rounded-pill px-3 flex-fill" title="Edit">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete" 
                                    data-product-id="@item.Id" data-product-name="@Html.Raw(Html.Encode(item.Name))" onclick="confirmDelete(this)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @if (!Model.Items.Any())
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x mb-3 text-muted"></i>
                    <h4 class="text-muted">No products found</h4>
                    <p class="text-muted mb-4">Create your first product to get started!</p>
                    <a asp-action="Create" class="btn btn-cyan px-4 py-2 rounded-pill">
                        <i class="fas fa-plus me-2"></i>Create Product
                    </a>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4">
            <div class="text-muted small">
                Showing @((Model.PageIndex - 1) * 8 + 1) to @Math.Min(Model.PageIndex * 8, Model.TotalItems) of @Model.TotalItems items
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link bg-dark text-light border-cyan" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @{
                        const int maxPagesToShow = 5;
                        var startPage = Math.Max(1, Model.PageIndex - maxPagesToShow / 2);
                        var endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);

                        for (var i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link bg-dark text-light border-cyan @(i == Model.PageIndex ? "bg-cyan text-dark" : "")"
                                   asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link bg-dark text-light border-cyan" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light border-cyan rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the product <span class="fw-bold text-gold">"<span id="ProductName"></span>"</span>?
                <div class="alert alert-warning mt-3 small">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone and will also delete all associated images.
                </div>
            </div>
            <div class="modal-footer border-0">
                <form asp-action="Delete" method="post" id="deleteForm">
                    <input type="hidden" name="id" id="ProductId" />
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .zenith-card {
            background: var(--card-bg, #181c24);
            border-radius: 1.5rem;
            box-shadow: 0 4px 32px rgba(0,0,0,0.25);
        }

        .zenith-card-title {
            color: var(--gold, #ffd700);
        }

        .btn-cyan, .btn-outline-cyan {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
            border: none;
        }

        .btn-outline-cyan {
            background: transparent;
            border: 2px solid var(--cyan-teal, #1de9b6);
            color: var(--cyan-teal, #1de9b6);
        }

        .product-card {
            background: #23272f !important;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(29, 233, 182, 0.15);
            }

        .product-image-container {
            height: 200px;
            overflow: hidden;
            position: relative;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.05);
        }

        .product-image-placeholder {
            height: 200px;
            background: #1a1e26;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .discount-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #dc3545;
            color: white;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .stock-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: #6c757d;
            color: white;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .product-title {
            color: var(--gold, #ffd700);
            font-size: 1.1rem;
            line-height: 1.3;
        }

        .current-price {
            font-size: 1.2rem;
        }

        .badge.bg-pink {
            background: #e91e63 !important;
        }

        .border-cyan {
            border-color: var(--cyan-teal, #1de9b6) !important;
        }

        .text-gold {
            color: var(--gold, #ffd700) !important;
        }

        .filter-section {
            background: #23272f;
        }

        .form-select:focus, .form-control:focus {
            border-color: var(--cyan-teal, #1de9b6);
            box-shadow: 0 0 0 0.2rem rgba(29,233,182,0.15);
        }
    </style>
}

@section Scripts {
    <script>
        function confirmDelete(button) {
            const productId = button.getAttribute('data-product-id');
            const productName = button.getAttribute('data-product-name');
            
            document.getElementById('ProductId').value = productId;
            document.getElementById('ProductName').textContent = productName;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
        
        function filterByCategory(categoryId) {
            if (categoryId) {
                window.location.href = '@Url.Action("Index")?categoryId=' + categoryId;
            } else {
                window.location.href = '@Url.Action("Index")';
            }
        }
        
        function filterByGender(gender) {
            if (gender) {
                window.location.href = '@Url.Action("Index")?gender=' + gender;
            } else {
                window.location.href = '@Url.Action("Index")';
            }
        }
        
        function searchProducts() {
            const searchTerm = document.getElementById('searchInput').value;
            if (searchTerm) {
                // This would require implementing search action
                alert('Search functionality to be implemented');
            }
        }
        
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}