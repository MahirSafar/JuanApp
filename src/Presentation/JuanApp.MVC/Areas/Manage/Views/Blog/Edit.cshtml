@model BlogViewModel

<div class="zenith-card p-4 shadow-lg rounded-4 border-0 bg-dark text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="zenith-card-title mb-1 fw-bold text-gold">Edit Blog Post</h2>
            <p class="text-muted mb-0">Update blog article with image management.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-cyan rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" class="row g-4">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Created" />
        <input type="hidden" asp-for="ImageUrl" />
        
        <div class="col-md-8">
            <div class="form-floating mb-4">
                <input asp-for="Title" class="form-control bg-dark text-light border-cyan" placeholder="Blog Title" />
                <label asp-for="Title" class="text-gold">Blog Title *</label>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="form-floating mb-4">
                <input asp-for="Author" class="form-control bg-dark text-light border-cyan" placeholder="Author Name" />
                <label asp-for="Author" class="text-gold">Author *</label>
                <span asp-validation-for="Author" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="col-12">
            <div class="image-upload-section p-4 rounded-4 bg-dark border border-cyan mb-4">
                <h5 class="text-gold mb-3">
                    <i class="fas fa-image me-2"></i>Featured Image Management
                </h5>
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="current-image mb-3">
                        <p class="small text-muted mb-2">Current Image:</p>
                        <div class="d-flex align-items-start gap-3">
                            <img src="~/uploads/blogs/@Model.ImageUrl" alt="Current image" class="current-image-preview rounded-3" />
                            <div>
                                <p class="small text-light mb-2">@Model.ImageUrl</p>
                                <div class="form-check">
                                    <input asp-for="RemoveImage" class="form-check-input" type="checkbox" id="removeImage" />
                                    <label class="form-check-label text-warning" for="removeImage">
                                        <i class="fas fa-trash me-1"></i>Remove current image (requires new image upload)
                                    </label>
                                    <div class="form-text text-muted small">
                                        Note: You must upload a replacement image when removing the current one.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="border-secondary" />
                }
                
                <div class="custom-file-upload">
                    <input asp-for="ImageFile" class="file-input" type="file" accept="image/*" id="imageFile" />
                    <label for="imageFile" class="file-label btn btn-outline-cyan">
                        <i class="fas fa-cloud-upload-alt me-2"></i>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <text>Replace Image</text>
                        }
                        else
                        {
                            <text>Choose Image</text>
                        }
                    </label>
                    <span class="file-name text-muted small ms-3">No file chosen</span>
                </div>
                
                <span asp-validation-for="ImageFile" class="text-danger small d-block mt-2"></span>
                
                <div class="form-text text-muted small mt-2">
                    <i class="fas fa-info-circle me-1"></i>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <text>Optional replacement image. Maximum file size: 5MB. Supported formats: JPG, PNG, GIF, WebP</text>
                    }
                    else
                    {
                        <text><strong>Required.</strong> Maximum file size: 5MB. Supported formats: JPG, PNG, GIF, WebP</text>
                    }
                </div>
                
                <div class="image-preview mt-3" id="imagePreview" style="display: none;">
                    <p class="small text-muted mb-2">New Image Preview:</p>
                    <img id="previewImg" class="preview-image rounded-3" alt="Preview" />
                </div>
            </div>
        </div>
        
        <div class="col-12">
            <label asp-for="Content" class="form-label text-gold fw-semibold">Blog Content *</label>
            <textarea asp-for="Content" class="form-control bg-dark text-light border-cyan" rows="12" placeholder="Write your blog content here..."></textarea>
            <span asp-validation-for="Content" class="text-danger small"></span>
            <div class="form-text text-muted small">
                <i class="fas fa-info-circle me-1"></i>
                You can use HTML tags for formatting.
            </div>
        </div>
        
        <div class="col-12">
            <div class="alert alert-warning border-warning bg-dark text-light">
                <h6 class="text-warning mb-2"><i class="fas fa-clock me-2"></i>Blog Information:</h6>
                <div class="small">
                    <p class="mb-1"><strong>Created:</strong> @Model.Created.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                    @if (Model.LastModified.HasValue)
                    {
                        <p class="mb-0"><strong>Last Modified:</strong> @Model.LastModified.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-12">
            <button type="submit" class="btn btn-cyan px-4 rounded-pill fw-semibold shadow-sm">
                <i class="fas fa-save me-2"></i>Update Blog Post
            </button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .zenith-card {
            background: var(--card-bg, #181c24);
            border-radius: 1.5rem;
            box-shadow: 0 4px 32px rgba(0,0,0,0.25);
        }

        .zenith-card-title {
            color: var(--gold, #ffd700);
        }

        .btn-cyan, .btn-outline-cyan {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
            border: none;
        }

        .btn-outline-cyan {
            background: transparent;
            border: 2px solid var(--cyan-teal, #1de9b6);
            color: var(--cyan-teal, #1de9b6);
        }

            .btn-outline-cyan:hover, .btn-cyan:hover {
                background: #13bfa6;
                color: #fff;
            }

        .border-cyan {
            border-color: var(--cyan-teal, #1de9b6) !important;
        }

        .text-gold {
            color: var(--gold, #ffd700) !important;
        }

        .text-cyan {
            color: var(--cyan-teal, #1de9b6) !important;
        }

        .rounded-4 {
            border-radius: 1.5rem !important;
        }

        .shadow-lg {
            box-shadow: 0 8px 32px rgba(0,0,0,0.35) !important;
        }

        .form-floating > label {
            color: var(--gold, #ffd700);
        }

        .form-control {
            background: #23272f;
            color: #fff;
            border-radius: 0.75rem;
        }

            .form-control:focus {
                border-color: var(--cyan-teal, #1de9b6);
                box-shadow: 0 0 0 0.2rem rgba(29,233,182,0.15);
            }

        textarea.form-control {
            min-height: 300px;
            resize: vertical;
        }

        .alert.border-warning {
            background: #1a1e26 !important;
        }

        /* File Upload Styles */
        .custom-file-upload {
            display: flex;
            align-items: center;
        }

        .file-input {
            display: none;
        }

        .file-label {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .file-label:hover {
            background: var(--cyan-teal, #1de9b6);
            color: #181c24;
        }

        .preview-image, .current-image-preview {
            max-width: 300px;
            max-height: 200px;
            object-fit: cover;
            border: 2px solid var(--cyan-teal, #1de9b6);
        }

        .current-image-preview {
            width: 150px;
            height: 100px;
        }

        .image-upload-section {
            background: #23272f;
        }

        .form-check-input:checked {
            background-color: var(--cyan-teal, #1de9b6);
            border-color: var(--cyan-teal, #1de9b6);
        }
    </style>
}

@section Scripts {
    <script>
        document.getElementById('imageFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const fileName = document.querySelector('.file-name');
            const preview = document.getElementById('imagePreview');
            const previewImg = document.getElementById('previewImg');
            
            if (file) {
                fileName.textContent = file.name;
                fileName.classList.remove('text-muted');
                fileName.classList.add('text-cyan');
                
                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                fileName.textContent = 'No file chosen';
                fileName.classList.remove('text-cyan');
                fileName.classList.add('text-muted');
                preview.style.display = 'none';
            }
        });
        
        // Handle remove image checkbox
        document.getElementById('removeImage').addEventListener('change', function(e) {
            const currentImage = document.querySelector('.current-image');
            const imageFile = document.getElementById('imageFile');
            
            if (e.target.checked) {
                currentImage.style.opacity = '0.5';
                // Make file input required when removing current image
                imageFile.setAttribute('required', 'required');
            } else {
                currentImage.style.opacity = '1';
                // Remove required attribute when keeping current image
                imageFile.removeAttribute('required');
            }
        });
        
        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const removeImage = document.getElementById('removeImage');
            const imageFile = document.getElementById('imageFile');
            const hasCurrentImage = @(string.IsNullOrEmpty(Model.ImageUrl) ? "false" : "true");
            
            // If removing image, must provide replacement
            if (removeImage && removeImage.checked && (!imageFile.files || imageFile.files.length === 0)) {
                e.preventDefault();
                alert('When removing the current image, you must upload a replacement image.');
                imageFile.focus();
                return false;
            }
            
            // If no current image, must provide one
            if (!hasCurrentImage && (!imageFile.files || imageFile.files.length === 0)) {
                e.preventDefault();
                alert('Please select a featured image for your blog post.');
                imageFile.focus();
                return false;
            }
        });
    </script>
}