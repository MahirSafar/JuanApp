@using JuanApp.Domain.Models
@model UserProfileVm
<!-- main wrapper start -->
<main>
    <!-- breadcrumb area start -->
    <div class="breadcrumb-area bg-img" data-bg="assets/img/banner/breadcrumb-banner.jpg">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-wrap text-center">
                        <nav aria-label="breadcrumb">
                            <h1 class="breadcrumb-title">My Account</h1>
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">My Account</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- breadcrumb area end -->
    <!-- my account wrapper start -->
    <div class="my-account-wrapper section-padding">
        <div class="container custom-container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- My Account Page Start -->
                    <div class="myaccount-page-wrapper">
                        <!-- My Account Tab Menu Start -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4">
                                <div class="myaccount-tab-menu nav" role="tablist">
                                    <a href="#dashboad" class="@(ViewBag.Tab == "dashboard" ? "active" : "")" data-toggle="tab">
                                        <i class="fa fa-dashboard"></i>
                                        Dashboard
                                    </a>
                                    <a asp-action="UserProfile" asp-route-tab="orders" class="@(ViewBag.Tab == "orders" ? "active" : "")">
                                        <i class="fa fa-cart-arrow-down"></i> Orders
                                    </a>
                                    <a href="#account-info" class="@(ViewBag.Tab == "profile" ? "active" : "")" data-toggle="tab">
                                        <i class="fa fa-user"></i> Account Details
                                    </a>
                                    <a asp-action="TwoFA" >
                                        <i class="fa fa-shield"></i> Two-factor
                                    </a>
                                    <a asp-action="logout">
                                        <i class="fa fa-sign-out"></i> Logout
                                    </a>
                                </div>
                            </div>
                            <!-- My Account Tab Menu End -->
                            <!-- My Account Tab Content Start -->
                            <div class="col-lg-9 col-md-8">
                                <div class="tab-content" id="myaccountContent">
                                    <!-- Single Tab Content Start -->
                                    <div class="tab-pane fade @(ViewBag.Tab == "dashboard" ? "show active" : "")" id="dashboad" role="tabpanel">
                                        <div class="myaccount-content">
                                            <h3>Dashboard</h3>
                                            <div class="welcome">
                                                <p>Hello, <strong>@Model.userUpdateProfile.FullName</strong> (If Not <strong>@Model.userUpdateProfile.Username !</strong><a asp-action="logout" class="logout"> Logout</a>)</p>
                                            </div>
                                            <p class="mb-0">From your account dashboard. you can easily check & view your recent orders, manage your shipping and billing addresses and edit your password and account details.</p>
                                            
                                            <div class="dashboard-quick-actions mt-4">
                                                <div class="row">
                                                    <div class="col-md-4 mb-3">
                                                        <div class="card border-primary">
                                                            <div class="card-body text-center">
                                                                <i class="fa fa-shopping-cart fa-2x text-primary mb-2"></i>
                                                                <h5 class="card-title">View Orders</h5>
                                                                <a asp-action="UserProfile" asp-route-tab="orders" class="btn btn-primary btn-sm">Go to Orders</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 mb-3">
                                                        <div class="card border-success">
                                                            <div class="card-body text-center">
                                                                <i class="fa fa-user fa-2x text-success mb-2"></i>
                                                                <h5 class="card-title">Edit Profile</h5>
                                                                <a href="#account-info" data-toggle="tab" class="btn btn-success btn-sm">Edit Details</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 mb-3">
                                                        <div class="card border-warning">
                                                            <div class="card-body text-center">
                                                                <i class="fa fa-shield fa-2x text-warning mb-2"></i>
                                                                <h5 class="card-title">Security</h5>
                                                                <a asp-action="TwoFA" class="btn btn-warning btn-sm">Manage 2FA</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Single Tab Content End -->
                                    
                                    <!-- Orders Tab Content Start -->
                                    <div class="tab-pane fade @(ViewBag.Tab == "orders" ? "show active" : "")" id="orders" role="tabpanel">
                                        <div class="myaccount-content">
                                            <h3>My Orders</h3>
                                            @if (Model.UserOrders.Any())
                                            {
                                                <div class="myaccount-table table-responsive">
                                                    <table class="table table-striped table-hover">
                                                        <thead class="thead-dark">
                                                            <tr>
                                                                <th>Order #</th>
                                                                <th>Date</th>
                                                                <th>Status</th>
                                                                <th>Items</th>
                                                                <th>Total</th>
                                                                <th>Action</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var order in Model.UserOrders)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <strong class="text-primary">@order.OrderNumber</strong>
                                                                    </td>
                                                                    <td>
                                                                        @order.OrderDate.ToString("MMM dd, yyyy")
                                                                        <br>
                                                                        <small class="text-muted">@order.OrderDate.ToString("HH:mm")</small>
                                                                    </td>
                                                                    <td>
                                                                        @switch (order.Status)
                                                                        {
                                                                            case OrderStatus.Pending:
                                                                                <span class="badge badge-warning">Pending</span>
                                                                                break;
                                                                            case OrderStatus.Confirmed:
                                                                                <span class="badge badge-info">Confirmed</span>
                                                                                break;
                                                                            case OrderStatus.Shipped:
                                                                                <span class="badge badge-primary">Shipped</span>
                                                                                break;
                                                                            case OrderStatus.Delivered:
                                                                                <span class="badge badge-success">Delivered</span>
                                                                                break;
                                                                            case OrderStatus.Cancelled:
                                                                                <span class="badge badge-danger">Cancelled</span>
                                                                                break;
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <span class="badge badge-secondary">@order.ItemCount items</span>
                                                                    </td>
                                                                    <td>
                                                                        <strong class="text-success">@order.TotalAmount.ToString("C")</strong>
                                                                    </td>
                                                                    <td>
                                                                        <a asp-action="OrderDetail" asp-route-id="@order.Id" 
                                                                           class="btn btn-sm btn-outline-primary">
                                                                            <i class="fa fa-eye"></i> View
                                                                        </a>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="empty-orders text-center py-5">
                                                    <i class="fa fa-shopping-cart fa-4x text-muted mb-3"></i>
                                                    <h4 class="text-muted">No Orders Yet</h4>
                                                    <p class="text-muted">You haven't placed any orders yet. Start shopping to see your orders here!</p>
                                                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                                                        <i class="fa fa-shopping-bag"></i> Start Shopping
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <!-- Orders Tab Content End -->
                                    
                                    <!-- Single Tab Content Start -->
                                    <div class="tab-pane fade @(ViewBag.Tab == "profile" ? "show active" : "")" id="account-info" role="tabpanel">
                                        <div class="myaccount-content">
                                            <h3>Account Details</h3>
                                            <div class="account-details-form">
                                                @await Html.PartialAsync("_UserProfilePartial", Model.userUpdateProfile)
                                            </div>
                                        </div>
                                    </div> 
                                </div>
                            </div> <!-- My Account Tab Content End -->
                        </div>
                    </div> <!-- My Account Page End -->
                </div>
            </div>
        </div>
    </div>
    <!-- my account wrapper end -->
</main>
<!-- main wrapper end -->

<style>
    .dashboard-quick-actions .card {
        transition: transform 0.2s ease-in-out;
        border-radius: 10px;
    }
    
    .dashboard-quick-actions .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    
    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }
    
    .badge-warning {
        background-color: #ffc107;
        color: #212529;
    }
    
    .badge-info {
        background-color: #17a2b8;
    }
    
    .badge-primary {
        background-color: #007bff;
    }
    
    .badge-success {
        background-color: #28a745;
    }
    
    .badge-danger {
        background-color: #dc3545;
    }
    
    .badge-secondary {
        background-color: #6c757d;
    }
    
    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 1px;
    }
    
    .empty-orders {
        background: #f8f9fa;
        border-radius: 10px;
        margin: 20px 0;
    }
    
    .myaccount-tab-menu a {
        transition: all 0.3s ease;
    }
    
    .myaccount-tab-menu a:hover {
        transform: translateX(5px);
    }
</style>