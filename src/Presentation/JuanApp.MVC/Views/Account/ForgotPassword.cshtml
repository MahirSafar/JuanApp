@model ForgotPasswordVm
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="~/assets/custom/css/forgotPassword.css" rel="stylesheet" />
</head>
<body>

    <div class="container">
        <div class="header">
            <div class="lock-icon"></div>
            <h1>Forgot Password?</h1>
            <p>No worries! Enter your email address and we'll send you a reset link.</p>
        </div>

        <div class="form-container">
            <!-- Display TempData messages from the controller -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Display validation errors for the model -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-icon">
                        <input asp-for="Email" type="email" id="email" required placeholder="Enter your email address">
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="submit-btn">
                    Send Reset Link
                </button>
            </form>

            <div class="back-link">
                <a asp-action="Login" asp-controller="Account">← Back to Login</a>
            </div>
        </div>
    </div>

</body>
</html>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js" integrity="sha512-KFHXdr2oObHKI9w4Hv1XPKc898mE4kgYx58oqsc/JqqdLMDI4YjOLzom+EMlW8HFUd0QfjfAvxSL6sEq/a42fQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" integrity="sha512-xq+Vm8jC94ynOikewaQXMEkJIOBp7iArs3IhFWSWdRT3Pq8wFz46p+ZDFAR7kHnSFf+zUv52B3prRYnbDRdgog==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}